{
  "name": "midi-qol",
  "title": "Midi QOL",
  "version": "15.0.0",
  "description": "Automates rolling weapon/spell attacks and applying damage amongst other things",
  "devDir": "/home/timp/foundry-data/foundryv13/Data/modules/",
  "main": "src/midi-qol.ts",
  "types": "types/midi-qol.d.ts",
  "scripts": {
    "build": "npx gulp",
    "watch": "npx gulp watch",
    "clean": "npx gulp clean",
    "devbuild": "npx gulp dev",
    "devwatch": "npx gulp devWatch",
    "devclean": "npx gulp devClean",
    "release": "npx gulp zip",
    "tag": "git remote get-url origin | grep -q github.com || { echo 'origin is not GitHub: tags must never reach GitLab'; exit 1; }; git tag -a v$npm_package_version -m \"version $npm_package_version release tag\" && git push origin v$npm_package_version",
    "generate:types": "node scripts/generate-types.mjs",
    "generate:completions": "node scripts/generateFoundryCompletions.js",
    "compilePacks": "npx gulp compilePacks",
    "extractPacks": "npx gulp extractPacks",
    "surface": "node tools/surface.mjs",
    "surface:check": "node tools/surface.mjs --check",
    "types": "node scripts/generate-types.mjs && node tools/build-types-package.mjs",
    "check:package": "node tools/build-check-package.mjs",
    "test": "vitest run",
    "corpus:books": "node tools/book-corpus.mjs",
    "test:watch": "vitest",
    "test:types": "tsc -p tsconfig.test.json"
  },
  "prettier": {
    "tabWidth": 2,
    "semi": true,
    "quoteProps": "consistent",
    "trailingComma": "all",
    "printWidth": 120
  },
  "devDependencies": {
    "@ethaks/fvtt-quench": "^0.6.0",
    "@foundryvtt/foundryvtt-cli": "^1.0.3",
    "@types/jest": "^27.4.1",
    "cross-var": "^1.1.0",
    "del": "^6.0.0",
    "esbuild": "^0.24.0",
    "fvtt-types": "14.370.0-beta.20261107215328",
    "gulp": "^4.0.2",
    "gulp-cli": "^2.3.0",
    "gulp-minify": "^3.1.0",
    "gulp-multi-dest": "^1.3.7",
    "gulp-rename": "^2.0.0",
    "gulp-sourcemaps": "^3.0.0",
    "gulp-tabify": "0.0.2",
    "gulp-typescript": "^6.0.0-alpha.1",
    "gulp-zip": "^5.0.2",
    "json-stringify-pretty-compact": "^3.0.0",
    "karma-cli": "^2.0.0",
    "prettier": "^2.7.1",
    "readline-sync": "^1.4.10",
    "typescript": "~5.9.3",
    "vite": "^7.3.8",
    "vitest": "^5.1.0",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
