      "overlay": {
        "identifier": "dispel-evil-and-good",
        "rules": "2024",
        "version": "1"
      },
      "entries": [
        {
          "id": "break",
          "on": "use.target.each",
          "if": "use.activity?.id === 'eBbyE0du7mEJWDbZ'",
          "label": "Break Enchantment",
          "do": [
            {
              "effect": "remove",
              "what": {
                "statuses": [
                  "charmed",
                  "frightened"
                ],
                "fromTypes": [
                  "celestial",
                  "elemental",
                  "fey",
                  "fiend",
                  "undead"
                ]
              },
              "to": "target"
            }
          ]
        },
        {
          "id": "break-ends",
          "on": "use.end",
          "if": "use.activity?.id === 'eBbyE0du7mEJWDbZ'",
          "label": "The spell ends",
          "do": [
            {
              "effect": "remove",
              "what": "concentrating",
              "to": "self"
            }
          ]
        }
      ]
    }
