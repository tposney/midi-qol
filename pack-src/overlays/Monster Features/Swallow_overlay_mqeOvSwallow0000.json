  "flags": {
    "midi-qol": {
      "overlay": {
        "identifier": "swallow",
        "rules": "2024",
        "version": "1"
      },
      "configSpec": [
        {
          "key": "damageWhen",
          "label": "Swallowed creatures take damage at",
          "type": "select",
          "options": [
            {
              "value": "originTurnStart",
              "label": "the start of the swallower's turn"
            },
            {
              "value": "originTurnEnd",
              "label": "the end of the swallower's turn"
            },
            {
              "value": "turnStart",
              "label": "the start of the swallowed creature's turn"
            }
          ],
          "default": "originTurnStart",
          "byCreature": {
            "giant-frog": "originTurnEnd",
            "giant-toad": "originTurnEnd",
            "kraken": "turnStart"
          }
        },
        {
          "key": "regurgitate",
          "label": "Damage from inside in one turn that forces the regurgitation save (0: none)",
          "type": "number",
          "default": 30,
          "byCreature": {
            "kraken": 50,
            "tarrasque": 60,
            "giant-frog": 0,
            "giant-toad": 0
          }
        },
        {
          "key": "regurgitateDC",
          "label": "Regurgitation save DC",
          "type": "number",
          "default": 20,
          "byCreature": {
            "behir": 14,
            "kraken": 25,
            "purple-worm": 22,
            "remorhaz": 15,
            "tarrasque": 20
          }
        },
        {
          "key": "disgorge",
          "label": "Disgorges the creature after its first damage (Giant Frog)",
          "type": "checkbox",
          "default": false,
          "byCreature": {
            "giant-frog": true
          }
        }
      ],
      "entries": [
        {
          "id": "ungrapple",
          "on": "use.target.saveFailed",
          "if": "use.activity?.id === 'YorssyWMumAsvzx3'",
          "label": "No longer Grappled",
          "do": [
            {
              "effect": "remove",
              "what": "grappled",
              "to": "target",
              "whole": true
            }
          ]
        },
        {
          "id": "ungrapple-frog",
          "on": "use.target.each",
          "if": "use.activity?.id === 'IPD9mDjKJEXc2uMQ'",
          "label": "No longer Grappled",
          "do": [
            {
              "effect": "remove",
              "what": "grappled",
              "to": "target",
              "whole": true
            }
          ]
        },
        {
          "id": "released",
          "on": "dies",
          "label": "Swallowed creatures released",
          "do": [
            {
              "effect": "apply",
              "what": "prone",
              "to": "inside"
            },
            {
              "effect": "remove",
              "what": {
                "origin": "this item"
              },
              "to": "anyone"
            }
          ]
        },
        {
          "id": "regurgitate",
          "on": "damaged",
          "if": "config.regurgitate > 0 && inside(use.token, bearer)",
          "label": "Regurgitation",
          "do": [
            {
              "tally": "swallowedDamage",
              "add": "@event.damage.totalDamage"
            },
            {
              "if": "(tallies.swallowedDamage ?? 0) >= config.regurgitate",
              "save": {
                "ability": "con",
                "dc": "@config.regurgitateDC"
              },
              "by": "bearer",
              "label": "Regurgitation",
              "else": [
                {
                  "effect": "apply",
                  "what": "prone",
                  "to": "inside"
                },
                {
                  "effect": "remove",
                  "what": {
                    "origin": "this item"
                  },
                  "to": "anyone"
                }
              ]
            }
          ]
        }
      ]
    }
  },
