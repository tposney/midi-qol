          "on": "use.target.hit",
          "offer": "ask",
          "label": "Forceful Bash: Push",
          "description": "midi-qol.Overlay.ShieldCavalier.Push",
          "if": "use.activity.id === 'ABPaLpY5mrKpB4ou'",
          "do": [
            {
