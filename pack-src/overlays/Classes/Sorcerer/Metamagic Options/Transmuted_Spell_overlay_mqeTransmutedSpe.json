            "from": [
              "metamagic-adept",
              "font-of-magic"
            ],
            "label": "midi-qol.Metamagic.SorceryPoints"
          },
          "groupLimit": "bearer.items.some(i => i.identifier === 'sorcery-incarnate') && bearer.appliedEffects.some(e => e.name === bearer.items.find(i => i.identifier === 'innate-sorcery')?.name) ? 2 : 1",
          "on": "use.damageRolled",
          "if": "tags.use.kind === 'spell' && ['acid', 'cold', 'fire', 'lightning', 'poison', 'thunder'].some(t => tags.use.damageTypes.has(t))",
          "choose": {
            "kind": "damageType",
            "options": [
              "acid",
              "cold",
              "fire",
              "lightning",
              "poison",
              "thunder"
            ],
            "label": "Transmuted Spell: new type"
          },
          "do": [
