    "midi-qol": {
      "entries": [
        {
          "id": "extended",
          "label": "Extended Spell",
          "who": "owner",
          "offer": "casting",
          "group": "metamagic",
          "cost": {
            "amount": 1,
            "from": [
              "metamagic-adept",
              "font-of-magic"
            ],
            "label": "midi-qol.Metamagic.SorceryPoints"
          },
          "groupLimit": "bearer.items.some(i => i.identifier === 'sorcery-incarnate') && bearer.appliedEffects.some(e => e.name === bearer.items.find(i => i.identifier === 'innate-sorcery')?.name) ? 2 : 1",
          "on": [
            "use.configure",
            "use.end"
          ],
          "if": "tags.use.kind === 'spell' && (['minute', 'hour', 'day'].includes(use.activity.duration.units) || (use.activity.duration.units === 'round' && use.activity.duration.value >= 10))",
          "do": [
            {
              "on": "use.configure",
              "if": "use.activity.duration.units === 'round'",
              "change": {
                "duration": "min(@value * 2, 14400)"
              }
            },
            {
              "on": "use.configure",
              "if": "use.activity.duration.units === 'minute'",
              "change": {
                "duration": "min(@value * 2, 1440)"
              }
            },
            {
              "on": "use.configure",
              "if": "use.activity.duration.units === 'hour'",
              "change": {
                "duration": "min(@value * 2, 24)"
              }
            },
            {
              "on": "use.end",
              "if": "use.item.system.properties.has('concentration')",
              "effect": "apply",
              "what": "Extended Spell: Concentration",
              "to": "self",
              "dependsOn": "concentration"
            }
          ]
        }
      ],
      "overlay": {
