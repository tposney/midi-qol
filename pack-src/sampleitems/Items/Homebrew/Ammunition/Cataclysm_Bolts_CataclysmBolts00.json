    "dae": {
      "macro": {
        "name": "Cataclysm Bolts",
        "img": "icons/weapons/ammunition/arrow-head-war-flight.webp",
        "type": "script",
        "scope": "global",
        "command": "// Cataclysm Bolts — on hit, roll d6 for the effect (postActiveEffects)\nconst version = \"13.0.66\";\ntry {\n  if (args[0].tag !== \"OnUse\" || args[0].macroPass !== \"postActiveEffects\") return;\n  const workflow = MidiQOL.Workflow.getWorkflow(args[0].workflowId ?? args[0].itemCardUuid);\n  const hit = workflow?.hitTargets?.documents ?? [];\n  if (!hit.length) return;                       // the bolt only triggers on a hit\n  const target = hit[0];\n\n  const ammo = workflow.ammunition;              // the bolt itself\n  if (!ammo) return;\n  // Look up by id: dnd5e regenerates `identifier` from the activity name, so it is not stable.\n  const pick = (id) => ammo.system.activities.get(id);\n\n  const roll = await new Roll(\"1d6\").evaluate();\n  await roll.toMessage({ flavor: \"Cataclysm Bolt effect\", speaker: ChatMessage.getSpeaker({ actor: workflow.actor }) });\n  const r = roll.total;\n\n  // 1-2 fire burst, 3-4 jagged ice, 5 necrotic pulse, 6 shrapnel\n  const FIRE = \"cataBoltFire0000\", ICE = \"cataBoltIce00000\",\n        NECRO = \"cataBoltNecro000\", SHRAPNEL = \"cataBoltShrap000\";\n  const chosen = r <= 2 ? FIRE : r <= 4 ? ICE : r === 5 ? NECRO : SHRAPNEL;\n  const activity = pick(chosen);\n  if (!activity) return ui.notifications?.warn(`Cataclysm Bolts: no activity ${chosen}`);\n\n  // Fire and ice also catch everything within 5 feet of the target.\n  let targetUuids = [target.uuid];\n  if (chosen === FIRE || chosen === ICE) {\n    const nearby = MidiQOL.findNearby(null, target.uuid, 5, { includeIncapacitated: true }) ?? [];\n    targetUuids = [target.uuid, ...nearby.map(t => t.document.uuid)];\n  }\n\n  if (chosen === SHRAPNEL) {\n    // Six separate ranged attacks at the same target rather than one bundled roll.\n    for (let i = 0; i < 6; i++) {\n      if ((target.actor?.system.attributes.hp.value ?? 0) <= 0) break;\n      await MidiQOL.completeActivityUse(activity,\n        { midiOptions: { targetUuids: [target.uuid], targetConfirmation: \"none\", configureDialog: false } },\n        { configure: false }, {});\n    }\n  } else {\n    await MidiQOL.completeActivityUse(activity,\n      { midiOptions: { targetUuids, targetConfirmation: \"none\", configureDialog: false } },\n      { configure: false }, {});\n  }\n} catch (err) {\n  console.error(\"Cataclysm Bolts macro error\", err);\n}\n",
        "author": null,
        "ownership": {
          "default": 3
        },
        "_id": null,
        "folder": null,
        "sort": 0,
        "flags": {},
