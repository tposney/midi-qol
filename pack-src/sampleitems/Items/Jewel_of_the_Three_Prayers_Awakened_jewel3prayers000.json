  "flags": {
    "core": {},
    "itemacro": {
      "macro": {
        "name": "Jewel of the Three Prayers (Awakened)",
        "type": "script",
        "img": "icons/svg/dice-target.svg",
        "scope": "global",
        "command": "const pass = args[0].macroPass;\n\n// Third party reaction: an ally within 60ft failed a save - offer to spend a charge for a reroll.\nif (args[0].tag === \"TargetOnUse\" && pass === \"isSaveFailure\") {\n  const jewel = macroItem;\n  const owner = jewel?.actor;\n  if (!owner) return;\n  const failed = token;\n  if (!failed?.actor) return;\n  if (failed.actor.uuid === owner.uuid) return; // \"another creature\"\n  if ((jewel.system.uses?.value ?? 0) < 1) return;\n  if (MidiQOL.hasUsedReaction(owner)) return;\n\n  const ownerToken = MidiQOL.tokenForActor(owner);\n  if (!ownerToken) return;\n  if (MidiQOL.computeDistance(ownerToken, failed) > 60) return;\n  if (!MidiQOL.canSee(ownerToken, failed)) return;\n\n  const reaction = jewel.system.activities.get(\"jewel3prayReact0\");\n  if (!reaction) return;\n\n  // Hand the prompt to midi so it is shown on the jewel owner's client, not wherever this macro runs.\n  const player = MidiQOL.playerForActor(owner);\n  if (!player?.active) return;\n  const payload = {\n    tokenUuid: ownerToken.document.uuid,\n    reactionFlavor: `${failed.name} failed a ${CONFIG.DND5E.abilities?.[[...(workflow.saveActivity?.save?.ability ?? [])][0]]?.label ?? \"saving\"} throw within 60 feet. Expend a charge of ${jewel.name} to let them reroll?`,\n    triggerTokenUuid: failed.document.uuid,\n    triggerType: \"reactionmanual\",\n    options: { workflowId: workflow.id },\n    reactionActivityList: [{\n      itemName: jewel.name, itemId: jewel.id, actionName: reaction.name,\n      img: jewel.img, id: reaction.id, uuid: reaction.uuid\n    }]\n  };\n  const socket = MidiQOL.socket();\n  const result = player.isGM\n    ? await socket.executeAsGM(\"chooseReactions\", payload)\n    : await socket.executeAsUser(\"chooseReactions\", player.id, payload);\n  if (!result?.uuid || result.name === \"None\") return; // declined or timed out\n\n  const abl = [...(workflow.saveActivity?.save?.ability ?? [])][0] ?? \"dex\";\n  const abilities = failed.actor.system.abilities ?? {};\n  const bonus = abilities[abl]?.save?.value ?? abilities[abl]?.mod ?? 0;\n  const label = CONFIG.DND5E.abilities?.[abl]?.label ?? abl;\n  const reroll = await new CONFIG.Dice.D20Roll(`1d20 + ${bonus}`, failed.actor.getRollData(), {\n    flavor: `${label} Save - ${jewel.name} reroll`\n  }).evaluate();\n  await MidiQOL.displayDSNForRoll(reroll, \"savingThrow\");\n  return reroll; // midi replaces the save roll with whatever Roll is returned\n}\n\n// Free the Body: end grappled, paralyzed or restrained on yourself.\nif (pass === \"postActiveEffects\" && rolledActivity?.id === \"jewel3prayFree00\") {\n  const candidates = [\"grappled\", \"paralyzed\", \"restrained\"].filter(c => MidiQOL.hasCondition(actor, c));\n  if (!candidates.length) {\n    ui.notifications?.info(`${macroItem.name}: no grappled, paralyzed or restrained condition to end.`);\n    return;\n  }\n  let chosen = candidates[0];\n  if (candidates.length > 1) {\n    chosen = await foundry.applications.api.DialogV2.wait({\n      window: { title: macroItem.name },\n      content: \"<p>End which condition?</p>\",\n      buttons: candidates.map(c => ({ label: c.capitalize(), action: c })),\n      rejectClose: false\n    });\n    if (!chosen) return;\n  }\n  await actor.toggleStatusEffect(chosen, { active: false });\n}\n",
        "sort": 0,
        "ownership": {
          "default": 0
        },
        "flags": {},
        "_stats": {}
      }
    },
