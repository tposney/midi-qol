        "img": "icons/magic/symbols/runes-star-magenta.webp",
        "macroData": {
          "name": "Regain Focus",
          "command": "const version = \"13.0.61\";\ntry {\n  if (args[0].tag !== \"OnUse\" || args[0].macroPass !== \"postActiveEffects\") return;\n  const actor = rolledItem.parent;\n  const monksFocus = actor.items.find(i => i.system.identifier === \"monks-focus\");\n  if (!monksFocus) {\n    ui.notifications.warn(\"No Monk's Focus feature found on this actor.\");\n    return;\n  }\n  const rolled = workflow.utilityRoll?.total;\n  if (!rolled || rolled <= 0) {\n    ui.notifications.warn(\"No utility roll result \u2014 was the Martial Arts die rolled?\");\n    return;\n  }\n  const maxUses = monksFocus.system.uses.max;\n  const resolvedMax = typeof maxUses === \"string\"\n    ? Roll.safeEval(Roll.replaceFormulaData(maxUses, actor.getRollData()))\n    : maxUses;\n  const currentSpent = monksFocus.system.uses.spent;\n  const regained = Math.min(rolled, currentSpent);\n  if (regained > 0) {\n    await monksFocus.update({ \"system.uses.spent\": currentSpent - regained });\n    ChatMessage.create({\n      content: `<p><strong>${actor.name}</strong> regains <strong>${regained}</strong> Focus Point${regained !== 1 ? \"s\" : \"\"} (${currentSpent - regained}/${resolvedMax} spent).</p>`,\n      speaker: ChatMessage.getSpeaker({ actor })\n    });\n  } else {\n    ChatMessage.create({\n      content: `<p><strong>${actor.name}</strong> has no spent Focus Points to regain.</p>`,\n      speaker: ChatMessage.getSpeaker({ actor })\n    });\n  }\n} catch (err) {\n  console.error(`Dragonhide Belt ${version}`, err);\n}",
          "type": "script"
        },
