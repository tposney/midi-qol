      "macro": {
        "name": "Goggles of Night (Item Macro RAW) 10.0.37",
        "img": "icons/magic/control/hypnosis-mesmerism-eye.webp",
        "type": "script",
        "scope": "global",
        "command": "const tokenDocument = token.document;\nif (args[0] === \"on\") {\n    const updates = {};\n    updates[\"flags.midi-qol.gogglesSave\"] = {\n        \"sight\": tokenDocument._source.sight\n    };\n    let newRange = 60;\n    if (tokenDocument.sight.visionMode === \"darkvision\") newRange = tokenDocument.sight.range + 60;\n\n    updates[\"sight\"] = CONFIG.Canvas.visionModes[\"darkvision\"].vision.defaults;\n    updates.sight.visionMode = \"darkvision\";\n    updates.sight.range = newRange;\n    updates.sight.angle = 135;\n    return await tokenDocument.update(updates)\n} else if (args[0] === \"off\") {\n    const updates = tokenDocument.flags[\"midi-qol\"]?.gogglesSave ?? {};\n    updates[\"flags.midi-qol.gogglesSave\"] = _del;\n    return await tokenDocument.update(updates)\n}",
