    "dae": {
      "macro": {
        "name": "Starfall Bullet",
        "type": "script",
        "img": "icons/weapons/ammunition/shot-round-blue.webp",
        "scope": "global",
        "command": "// Starfall Bullet\n// Fired as ammunition (postActiveEffects of the sling's attack): on a hit, the impact (8d10 radiant) on the target and\n// the burst (DC 18 Dex, 4d10 fire, half on a success) on every other creature within 15 feet, then the crater, which\n// the GM runs (it creates a region and a light): difficult terrain and bright light for 1 minute.\nconst IMPACT = \"StarfallImpact00\", BURST = \"StarfallBurst000\", CRATER = \"StarfallCrater00\";\nif (args[0]?.tag !== \"OnUse\" || args[0].macroPass !== \"postActiveEffects\") return;\nconst name = macroItem?.name ?? \"Starfall Bullet\";\nconst auto = { targetConfirmation: \"none\", autoRollAttack: true, autoFastAttack: true, autoRollDamage: \"always\", autoFastDamage: true };\nconst use = (activity, targetUuids) => MidiQOL.completeActivityUse(activity, { midiOptions: { targetUuids, workflowOptions: auto } }, { configure: false }, {});\n\n// one of the bullet's own activities: only the crater does anything here, on the GM's client\nif (workflow?.item?.id === macroItem?.id && !workflow?.ammunition) {\n  if (workflow.activity?.id !== CRATER) return;\n  const target = workflow.targets?.first();\n  const scene = target?.document?.parent;\n  if (!target || !scene) return;\n  const { x, y } = target.center;\n  const [effect] = await actor.createEmbeddedDocuments(\"ActiveEffect\", [{ name: \"Starfall Crater\", img: macroItem.img,\n    duration: { seconds: 60 }, flags: { dae: { showIcon: false } } }]);\n  const [region] = await scene.createEmbeddedDocuments(\"Region\", [{ name: \"Starfall Crater\", color: \"#ffb347\", visibility: CONST.REGION_VISIBILITY.ALWAYS,\n    shapes: [{ type: \"circle\", x, y, radius: 15 * canvas.dimensions.distancePixels }],\n    behaviors: [{ name: \"Difficult Terrain\", type: \"dnd5e.difficultTerrain\" }] }]);\n  const [light] = await scene.createEmbeddedDocuments(\"AmbientLight\", [{ x, y,\n    config: { bright: 15, dim: 30, color: \"#ffd27a\", alpha: 0.5, animation: { type: \"starlight\", speed: 3, intensity: 3 } } }]);\n  // removed with the crater effect when its minute is up\n  await MidiQOL.addDependent(effect, region);\n  await MidiQOL.addDependent(effect, light);\n  return;\n}\n\nif (workflow?.ammunition?.id !== macroItem?.id) return;\nconst target = workflow.hitTargets?.first();\nif (!target) return;\nconst bullet = workflow.ammunition;\nawait ChatMessage.create({ speaker: ChatMessage.getSpeaker({ actor }), content: `<strong>${name}</strong>: the bullet bursts into a falling star.` });\nawait use(bullet.system.activities.get(IMPACT), [target.document.uuid]);\nconst others = MidiQOL.findNearby(null, target, 15, { includeIncapacitated: true }).map(t => t.document.uuid);\nif (others.length) await use(bullet.system.activities.get(BURST), others);\nconst crater = bullet.system.activities.get(CRATER);\nif (game.user.isGM) await use(crater, [target.document.uuid]);\nelse await MidiQOL.socket().executeAsGM(\"completeActivityUse\", { activityUuid: crater.uuid, actorUuid: actor.uuid,\n  usage: { midiOptions: { targetUuids: [target.document.uuid], workflowOptions: auto } }, dialog: { configure: false }, message: {} });\n"
      }
    },
    "chris-premades": {
      "info": {
        "source": "midi-qol.midiqol-sample-items",
        "version": "13.0.69"
      }
    }
