    "itemacro": {
      "macro": {
        "name": "Prismatic Spray",
        "type": "script",
        "img": "icons/svg/dice-target.svg",
        "scope": "global",
        "command": "// Prismatic Spray — postActiveEffects macro\n// Only run for the main cast activity, not ray sub-activities\nif (workflow.activity?._id !== \"dnd5eactivity000\") return;\n\n// 2024 PHB rays: 1=Red (Fire), 2=Orange (Acid), 3=Yellow (Lightning),\n// 4=Green (Poison), 5=Blue (Cold), 6=Indigo (Restrained), 7=Violet (Blinded), 8=Two rays\nconst RAY_NAMES = [\"\", \"Red\", \"Orange\", \"Yellow\", \"Green\", \"Blue\", \"Indigo\", \"Violet\"];\nconst RAY_DAMAGE_TYPES = [\"\", \"fire\", \"acid\", \"lightning\", \"poison\", \"cold\"];\nconst RAY_COLORS = [\"\", \"#ff4444\", \"#ff8c00\", \"#ffd700\", \"#22cc22\", \"#4488ff\", \"#6a0dad\", \"#9b30ff\"];\n\nconst failedTargets = new Set(workflow.failedSaves);\nconst allTargets = Array.from(workflow.targets);\nconst rayMap = new Map();\nconst chatLines = [];\n\nfor (const tk of allTargets) {\n  const saved = !failedTargets.has(tk);\n  const roll = await new Roll(\"1d8\").evaluate();\n  let rays;\n  if (roll.total === 8) {\n    const r1 = await new Roll(\"1d7\").evaluate();\n    const r2 = await new Roll(\"1d7\").evaluate();\n    rays = [r1.total, r2.total];\n    chatLines.push(`<b>${tk.name}</b>: d8 = <b>8</b> (two rays!) \\u2192 <span style=\"color:${RAY_COLORS[r1.total]}\">${RAY_NAMES[r1.total]}</span> (d7: ${r1.total}) and <span style=\"color:${RAY_COLORS[r2.total]}\">${RAY_NAMES[r2.total]}</span> (d7: ${r2.total})`);\n  } else {\n    rays = [roll.total];\n    chatLines.push(`<b>${tk.name}</b>: d8 = <b>${roll.total}</b> \\u2192 <span style=\"color:${RAY_COLORS[roll.total]}\">${RAY_NAMES[roll.total]}</span> ray`);\n  }\n  for (const r of rays) {\n    if (!rayMap.has(r)) rayMap.set(r, []);\n    rayMap.get(r).push({ token: tk, saved });\n  }\n}\n\nawait ChatMessage.create({\n  content: `<b>Prismatic Spray — Ray Assignments</b><br>${chatLines.join(\"<br>\")}`,\n  speaker: ChatMessage.getSpeaker({ token: workflow.token })\n});\n\n// Damage rays (1-5): one 12d6 roll per ray type, shared among all targets hit by that ray\nconst targetDamages = [];\nfor (let ray = 1; ray <= 5; ray++) {\n  const targets = rayMap.get(ray);\n  if (!targets) continue;\n  const damageType = RAY_DAMAGE_TYPES[ray];\n  const dmgRoll = await new Roll(\"12d6\").evaluate();\n  for (const { token: tk, saved } of targets) {\n    const damage = saved ? Math.floor(dmgRoll.total / 2) : dmgRoll.total;\n    targetDamages.push({\n      token: tk,\n      damageDetail: [{ value: damage, type: damageType, properties: new Set([\"mgc\"]) }],\n      totalDamage: damage\n    });\n  }\n}\nif (targetDamages.length) {\n  await MidiQOL.applyTokenDamageMany(targetDamages, workflow.item, { workflow, forceApply: false });\n}\n\n// Helper: trigger a ray activity via completeActivityUse\nconst freshItem = actor.items.get(item.id);\nasync function triggerRayEffect(identifier, targetUuids) {\n  if (!targetUuids.length) return;\n  const act = freshItem.system.activities.find(a => a.identifier === identifier);\n  if (act) await MidiQOL.completeActivityUse(act, { midiOptions: { targetUuids } });\n}\n\n// Indigo ray (6): apply Restrained effect (with OverTime CON saves) to failed-save targets\nconst indigoTargets = rayMap.get(6);\nif (indigoTargets) {\n  const failedUuids = indigoTargets.filter(t => !t.saved).map(t => t.token.document.uuid);\n  await triggerRayEffect(\"indigo-ray\", failedUuids);\n}\n\n// Violet ray (7): apply Blinded effect (with OverTime WIS save) to failed-save targets\nconst violetTargets = rayMap.get(7);\nif (violetTargets) {\n  const failedUuids = violetTargets.filter(t => !t.saved).map(t => t.token.document.uuid);\n  await triggerRayEffect(\"violet-ray\", failedUuids);\n}",
        "sort": 0,
        "ownership": {
          "default": 3
        },
        "flags": {},
