    "dae": {
      "macro": {
        "name": "Shining Smite",
        "img": "icons/skills/melee/strike-sword-dagger-runes-yellow.webp",
        "type": "script",
        "scope": "global",
        "command": "const version = \"13.0.52\";\ntry {\n    if (rolledActivity.actionType !== \"mwak\") return {};\n    if (workflow.hitTargets.size === 0) return {};\n    const spells = actor.system.spells;\n    let options = \"\";\n    for (let i = 2; i <= 9; i++) {\n        const slot = spells[`spell${i}`];\n        if (slot && slot.value > 0) {\n            const numDice = 1 + i;\n            options += `<option value=\"spell${i}\">${slot.label} (${slot.value}) ${numDice}d6</option>`;\n        }\n    }\n    if (spells.pact?.value > 0 && spells.pact?.level >= 2) {\n        const numDice = 1 + spells.pact.level;\n        options += `<option value=\"pact\">${spells.pact.label} (${spells.pact.value}) ${numDice}d6</option>`;\n    }\n    if (!options) return {};\n    const useLabel = game.i18n.localize(\"DND5E.AbilityUseCast\");\n    const choice = await foundry.applications.api.DialogV2.wait({\n        window: {title: macroItem.name},\n        position: {width: 400},\n        content: `<form><p>${useLabel} ${macroItem.name}?</p><select name=\"slotKey\">${options}</select></form>`,\n        buttons: [\n            {action: \"use\", label: useLabel, default: true, callback: (event, button) => button.form.elements.slotKey.value},\n            {action: \"no\", label: game.i18n.localize(\"Cancel\"), callback: () => false}\n        ],\n        close: () => false\n    });\n    if (!choice) return {};\n    const slotKey = choice;\n    const slotPath = `system.spells.${slotKey}`;\n    const current = foundry.utils.getProperty(actor, slotPath);\n    if (current.value <= 0) return {};\n    await actor.update({[`${slotPath}.value`]: current.value - 1});\n    const slotLevel = current.level;\n    const numDice = 1 + slotLevel;\n    const applyActivity = macroItem.system.activities.find(a => a.identifier === \"applyShining\");\n    if (applyActivity) {\n        const targetUuids = Array.from(workflow.hitTargets).map(t => t.document.uuid);\n        const hookId = Hooks.on(\"midi-qol.RollComplete\", async (wf) => {\n            if (wf.id !== workflow.id) return;\n            Hooks.off(\"midi-qol.RollComplete\", hookId);\n            await MidiQOL.completeActivityUse(applyActivity, {midiOptions: {targetUuids}});\n        });\n    }\n    const isCritical = workflow.isCritical;\n    return await new CONFIG.Dice.DamageRoll(`${numDice}d6`, {}, {type: \"radiant\", isCritical, flavor: macroItem.name}).evaluate();\n} catch (err) {\n    console.error(`${macroItem.name} ${version}`, err);\n    return {};\n}",
        "author": "Zl1BOUaPLwDEujaL",
        "ownership": {
          "default": 3
        },
