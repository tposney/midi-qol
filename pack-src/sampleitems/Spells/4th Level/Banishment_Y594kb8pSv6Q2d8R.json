      "macro": {
        "name": "Banishment",
        "img": "icons/magic/unholy/barrier-fire-pink.webp",
        "type": "script",
        "scope": "global",
        "command": "const lastArg = args[args.length - 1];\nconst tokenId = lastArg.tokenId;\nif (args[0] === \"on\") {\n    await DAE.setTokenVisibility(tokenId, false);\n} else if (args[0] === \"off\") {\n    await DAE.setTokenVisibility(tokenId, true);\n}",
