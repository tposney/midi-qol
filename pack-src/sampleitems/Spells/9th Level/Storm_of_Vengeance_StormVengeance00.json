    "itemacro": {
      "macro": {
        "name": "Storm of Vengeance",
        "type": "script",
        "img": "icons/svg/dice-target.svg",
        "scope": "global",
        "command": "// Storm of Vengeance — DAE macro (startEveryTurn)\n// \"on\": Initialize round counter to 1 (round 1 already resolved by the Create Storm activity)\n// \"each\": Increment counter, trigger the appropriate round's activity\n// \"off\": Clean up the round counter flag\n\nconst FLAG = \"stormOfVengeanceRound\";\n\nif (args[0] === \"on\") {\n  await actor.setFlag(\"midi-qol\", FLAG, 1);\n} else if (args[0] === \"each\") {\n  const current = actor.getFlag(\"midi-qol\", FLAG) ?? 1;\n  const round = current + 1;\n  await actor.setFlag(\"midi-qol\", FLAG, round);\n  // Map round number to activity identifier\n  let identifier;\n  if (round === 2) identifier = \"acid-rain\";\n  else if (round === 3) identifier = \"lightning-bolts\";\n  else if (round === 4) identifier = \"hailstones\";\n  else if (round >= 5 && round <= 10) identifier = \"gusts-and-rain\";\n  else return; // Past round 10, no effect\n  const theItem = actor.items.find(i => i.system?.identifier === \"storm-of-vengeance\");\n  if (!theItem) return;\n  const activity = theItem.system.activities.find(a => a.identifier === identifier);\n  if (!activity) return;\n  const roundLabel = round >= 5 ? `Round ${round} (5+)` : `Round ${round}`;\n  // Find the storm template placed during round 1 and auto-target creatures under it\n  const templates = canvas.scene.templates.filter(t => {\n    const origin = t.flags?.dnd5e?.origin ?? \"\";\n    return origin.startsWith(theItem.uuid);\n  });\n  let targetUuids;\n  if (templates.length > 0) {\n    MidiQOL.selectTargetsFromTemplates(templates);\n    targetUuids = Array.from(game.user.targets).map(t => t.document.uuid);\n  }\n  ChatMessage.create({\n    content: `<strong>Storm of Vengeance</strong>: ${roundLabel} — ${activity.name}.`,\n    speaker: ChatMessage.getSpeaker({actor}),\n    whisper: game.users.filter(u => actor.testUserPermission(u, \"OWNER\")).map(u => u.id)\n  });\n  await MidiQOL.completeActivityUse(activity, {\n    midiOptions: {\n      targetUuids,\n      workflowOptions: {\n        autoConsumeResource: \"both\"\n      },\n      proceedChecks: {\n        checkReaction: false,\n        checkBonusAction: false\n      }\n    }\n  });\n} else if (args[0] === \"off\") {\n  if (actor.getFlag(\"midi-qol\", FLAG) !== undefined) {\n    await actor.unsetFlag(\"midi-qol\", FLAG);\n  }\n}",
        "sort": 0,
        "ownership": {
          "default": 3
        },
        "flags": {},
