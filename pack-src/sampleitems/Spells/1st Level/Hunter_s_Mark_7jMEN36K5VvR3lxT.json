        "useConditionText": "",
        "effectConditionText": "",
        "macroData": {
          "name": "Move Mark",
          "command": "const version = \"13.0.53\";\ntry {\n    const concEffect = MidiQOL.getConcentrationEffect(actor, macroItem);\n    if (!concEffect) return;\n    const markedEffects = concEffect.getDependents().filter(d =>\n        d instanceof ActiveEffect && d.statuses?.has(\"marked\")\n    );\n    if (markedEffects.length) {\n        const markedActor = markedEffects[0].parent;\n        const hp = markedActor?.system?.attributes?.hp?.value ?? 0;\n        if (hp > 0) {\n            const { DialogV2 } = foundry.applications.api;\n            const confirmed = await DialogV2.confirm({\n                window: { title: macroItem.name },\n                content: `<p>${markedActor.name} still has hit points. Move the mark anyway?</p>`,\n                rejectClose: false,\n            });\n            if (!confirmed) { workflow.aborted = true; return; }\n        }\n        for (const ef of markedEffects) await ef.delete();\n    }\n} catch (err) {\n    console.error(`${macroItem.name} Move Mark ${version}`, err);\n}"
        },
