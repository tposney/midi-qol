    "itemacro": {
      "macro": {
        "name": "Guidance",
        "type": "script",
        "scope": "global",
        "command": "// When Guidance Self bonus is used, end any active Guidance concentration on this actor.\n// This runs via macroToCall when the optional guidanceSelf bonus is accepted.\nlet guidanceConcentration;\nfor (const e of actor.concentration?.effects ?? []) {\n  const itemData = e.getFlag(\"dnd5e\", \"item\");\n  if (itemData && actor.items.get(itemData.id)?.name === \"Guidance\") {\n    guidanceConcentration = e;\n    break;\n  }\n}\nif (guidanceConcentration) {\n  await actor.endConcentration(guidanceConcentration);\n}\nreturn \"1d4\";",
        "img": "icons/sundries/lights/candle-lit-angelic.webp",
        "ownership": {
          "default": 3
        },
        "flags": {}
      }
    }
  },
  "system": {
    "description": {
      "value": "<p>You touch a willing creature and channel divination magic. Until the spell ends, the target adds 1d4 to one ability check of its choice, ending the spell.</p>\n<p><strong>midi-qol</strong>: Two effects on a single item.<br><strong>Transfer effect (Guidance Self)</strong>: Always active on the caster via <code>flags.midi-qol.optional.guidanceSelf.skill.all</code>. Prompts to add 1d4 on every skill check with <code>count: every</code>. A <code>macroToCall</code> runs an ItemMacro that ends any active Guidance concentration on the caster when the self-bonus is used.<br><strong>Activity effect (Guidance)</strong>: Cast on a willing target via the utility activity. Applies <code>flags.midi-qol.optional.guidance.skill.all</code> with <code>count: 1</code> — one use, then the effect expires and concentration ends. Duration 1 minute, concentration.</p>",
      "chat": "<p>You touch a willing creature and channel divination magic. Until the spell ends, the target adds 1d4 to one ability check of its choice, ending the spell.</p>"
    },
