    "dae": {
      "macro": {
        "name": "Spirit Guardians",
        "img": "icons/magic/light/orb-hands-humanoid-yellow.webp",
        "type": "script",
        "scope": "global",
        "command": "const version = \"13.0.52\";\ntry {\n    const lastArg = args[args.length - 1];\n    if (args[0] !== \"on\") return;\n    const effect = actor.effects.get(lastArg.effectId);\n    if (!effect) return;\n    // Source aura on the caster — nothing to do\n    if (!effect.flags?.auraeffects?.fromAura) return;\n    // Aura copy on another token — check disposition\n    const caster = macroItem?.parent;\n    const casterToken = caster?.getActiveTokens(false, true)?.[0];\n    const targetToken = canvas.tokens.get(lastArg.tokenId);\n    if (!targetToken || !casterToken) return;\n    if (targetToken.document.disposition === casterToken.disposition) return;\n    // Read cast level from effect flags (set by midi-qol when applying effects)\n    const castLevel = effect.flags?.[\"midi-qol\"]?.castData?.castLevel ?? macroItem.system.level;\n    const baseLevel = macroItem.system.level;\n    // Create dependent effect for movement reduction and overtime\n    await actor.createEmbeddedDocuments(\"ActiveEffect\", [{\n        name: \"Spirit Guardians\",\n        img: macroItem.img,\n        origin: macroItem.uuid,\n        changes: [\n            { key: \"system.attributes.movement.all\", type: \"custom\", value: \"/2\", priority: 20 },\n            { key: \"flags.midi-qol.ActivityOverTime\", type: \"override\", value: \"guardiansDamage\", priority: 20 }\n        ],\n        flags: {\n            dnd5e: { dependentOn: effect.uuid },\n            \"midi-qol\": { castData: { castLevel, baseLevel } },\n            dae: { showIcon: false, stackable: \"none\", macroRepeat: \"none\" }\n        }\n    }]);\n    // Trigger immediate save — midiOptions.spellLevel handled by _prepareUsageScaling override\n    const saveActivity = macroItem?.system?.activities?.find(a => a.identifier === \"guardiansDamage\");\n    if (!saveActivity) return;\n    await MidiQOL.completeActivityUse(saveActivity, {midiOptions: {spellLevel: castLevel, noUseWarning: true, targetUuids: [targetToken.document.uuid]}});\n} catch (err) {\n    console.error(`Spirit Guardians ${version}`, err);\n}",
        "author": "Zl1BOUaPLwDEujaL",
        "ownership": {
          "default": 3
        },
