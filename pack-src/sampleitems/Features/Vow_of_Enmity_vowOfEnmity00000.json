  "flags": {
    "core": {},
    "dae": {
      "macro": {
        "name": "Vow of Enmity",
        "type": "script",
        "img": "icons/svg/dice-target.svg",
        "scope": "global",
        "command": "const version = \"13.0.64\";\ntry {\n  if (args[0].macroPass !== \"postActiveEffects\") return;\n  const target = workflow.targets.first();\n  if (!target) return;\n  const ADV = \"flags.midi-qol.advantage.attack.all\";\n  const markName = \"Marked by Vow of Enmity\";\n  const mine = ef => MidiQOL.getItemFromEffectOrigin(ef.origin ?? \"\")?.uuid === macroItem.uuid;\n  const isTransfer = rolledActivity?.id === \"vowSwapVowAct000\";\n\n  const selfEffect = actor.effects.find(ef => ef.name === macroItem.name && mine(ef));\n  if (!selfEffect) {\n    if (isTransfer) {\n      ui.notifications?.warn(`${macroItem.name}: no active vow to transfer.`);\n      workflow.aborted = true;\n    }\n    return;\n  }\n\n  // RAW the vow only transfers once the vowed creature is at 0 HP.\n  if (isTransfer) {\n    const prevUuid = selfEffect.system.changes.find(c => c.key === ADV)?.value?.match(/\"([^\"]+)\"/)?.[1];\n    const prev = prevUuid ? await fromUuid(prevUuid) : null;\n    if (prev && (prev.actor?.system?.attributes?.hp?.value ?? 0) > 0) {\n      const ok = await foundry.applications.api.DialogV2.confirm({\n        window: { title: macroItem.name },\n        content: `<p>${prev.name} still has hit points - the vow transfers only when the vowed creature drops to 0. Transfer anyway?</p>`,\n        rejectClose: false\n      });\n      if (!ok) { workflow.aborted = true; return; }\n    }\n  }\n\n  // The advantage lives on the paladin; only the stored uuid changes.\n  const changes = selfEffect.system.changes.map(c => c.key === ADV\n    ? { ...c, value: `targetUuid === \"${target.document.uuid}\"` }\n    : c);\n  await selfEffect.update({ \"system.changes\": changes });\n\n  for (const t of canvas.tokens?.placeables ?? []) {\n    if (t.document.uuid === target.document.uuid) continue;\n    for (const ef of (t.actor?.effects ?? []).filter(ef => ef.name === markName && mine(ef))) await ef.delete();\n  }\n  const marker = target.actor?.effects?.find(ef => ef.name === markName && mine(ef));\n  if (marker) await MidiQOL.addDependent(selfEffect, marker);\n} catch (err) {\n  console.error(`${macroItem?.name} ${version}`, err);\n}\n",
        "sort": 0,
        "ownership": {
          "default": 0
        },
        "flags": {},
        "_stats": {}
      }
    },
