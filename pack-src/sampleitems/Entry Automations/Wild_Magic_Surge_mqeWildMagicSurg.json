{
  "name": "Wild Magic Surge",
  "type": "feat",
  "img": "icons/magic/lightning/bolt-strike-forked-blue.webp",
  "system": {
    "description": {
      "value": "<p>Once per turn, right after you cast a sorcerer spell with a spell slot, you can roll 1d20. On a 20, roll on the Wild Magic Surge table.</p><p><em>Automation (midi-qol entries):</em> having this feature is what turns it on: its entry (see Entries in the sheet's menu) runs when a use of yours ends, if it was a sorcerer spell cast with a slot, at most once a turn, asking you first. It rolls 1d20; on a 20 it rolls on the Wild Magic Surge table: a world table of that name if you have one (your own or a homebrew one), else the Player's Handbook's when that module is active, else it says to roll on yours. The table's text isn't part of midi.</em></p>",
      "chatFlavor": ""
    },
    "source": {
      "custom": "",
      "rules": "2024",
      "revision": 1,
      "license": "",
      "book": ""
    },
    "activities": {},
    "type": {
      "value": "class",
      "subtype": ""
    },
    "identifier": "wild-magic-surge"
  },
  "effects": [],
  "flags": {
    "midi-qol": {
      "entries": [
        {
          "id": "surge",
          "on": "use.end",
          "who": "owner",
          "offer": "ask",
          "limit": {
            "per": "turn"
          },
          "label": "Wild Magic Surge (d20)",
          "if": "tags.use.kind === 'spell' && !!tags.use.spellSlot && tags.use.class === 'sorcerer'",
          "do": [
            {
              "table": {
                "id": "surge.check",
                "formula": "1d20",
                "rows": [
                  {
                    "range": [
                      20,
                      20
                    ],
                    "label": "Wild Magic Surge!",
                    "do": [
                      {
                        "table": {
