                              "Compendium.dnd-players-handbook.tables.RollTable.phbWildMagicSurg"
                            ]
                          },
                          "formula": "1d100",
                          "rows": [
                            {
                              "range": [
                                1,
                                100
                              ],
                              "label": "Roll on your Wild Magic Surge table (none was found: make a world table named Wild Magic Surge, or enable the Player's Handbook module).",
                              "do": []
                            }
                          ]
                        }
                      }
                    ]
                  }
                ]
              }
            }
