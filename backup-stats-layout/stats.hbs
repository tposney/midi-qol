<section id="midi-stats-stats-tab" class="tab{{#if tab.active}} active{{/if}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">
    {{#if hasStats}}
        {{#each stats}}
            <div class="midi-stats-card" data-actor-id="{{@key}}">
                <div class="midi-stats-card-header" data-action="toggleExpand" data-actor-id="{{@key}}">
                    <i class="fas fa-chevron-right midi-stats-chevron"></i>
                    <span class="midi-stats-actor-name">{{this.name}}</span>
                    <button type="button" class="midi-stats-period-toggle" data-action="togglePeriod" data-actor-id="{{@key}}">
                        <i class="fas fa-clock-rotate-left"></i>
                        <span class="midi-stats-period-label-session">{{localize "midi-qol.stats.Session"}}</span>
                        <span class="midi-stats-period-label-lifetime">{{localize "midi-qol.stats.Lifetime"}}</span>
                    </button>
                </div>
                <div class="midi-stats-card-body">
                    <div class="midi-stats-blocks">
                        {{!-- Attacks Block --}}
                        <div class="midi-stats-block">
                            <div class="midi-stats-block-title">
                                <i class="fas fa-dice-d20"></i> {{localize "midi-qol.stats.Attacks"}}
                            </div>
                            <div class="midi-stats-block-section midi-stats-session">
                                <div class="midi-stats-line">{{this.session.numAttacks}} {{localize "midi-qol.stats.rolls"}}</div>
                                <div class="midi-stats-line">
                                    <span>{{this.session.numAttackCritical}} {{localize "midi-qol.stats.crits"}}</span>
                                    <span class="midi-stats-sep">/</span>
                                    <span>{{this.session.numAttackFumble}} {{localize "midi-qol.stats.fumbles"}}</span>
                                </div>
                                <div class="midi-stats-line">{{this.session.numDamageRolls}} {{localize "midi-qol.stats.hits"}}</div>
                                <div class="midi-stats-line">{{this.session.numAttack20}} {{localize "midi-qol.stats.nat20s"}}</div>
                                <div class="midi-stats-line">{{localize "midi-qol.stats.avgRoll"}}: {{this.session.attackRollAverage}}</div>
                                <div class="midi-stats-line">{{this.session.hitRate}}% {{localize "midi-qol.stats.hitRate"}}</div>
                            </div>
                            <div class="midi-stats-block-section midi-stats-lifetime">
                                <div class="midi-stats-line">{{this.lifetime.numAttacks}} {{localize "midi-qol.stats.rolls"}}</div>
                                <div class="midi-stats-line">
                                    <span>{{this.lifetime.numAttackCritical}} {{localize "midi-qol.stats.crits"}}</span>
                                    <span class="midi-stats-sep">/</span>
                                    <span>{{this.lifetime.numAttackFumble}} {{localize "midi-qol.stats.fumbles"}}</span>
                                </div>
                                <div class="midi-stats-line">{{this.lifetime.numDamageRolls}} {{localize "midi-qol.stats.hits"}}</div>
                                <div class="midi-stats-line">{{this.lifetime.numAttack20}} {{localize "midi-qol.stats.nat20s"}}</div>
                                <div class="midi-stats-line">{{localize "midi-qol.stats.avgRoll"}}: {{this.lifetime.attackRollAverage}}</div>
                                <div class="midi-stats-line">{{this.lifetime.hitRate}}% {{localize "midi-qol.stats.hitRate"}}</div>
                            </div>
                        </div>

                        {{!-- Damage Block --}}
                        <div class="midi-stats-block">
                            <div class="midi-stats-block-title">
                                <i class="fas fa-burst"></i> {{localize "midi-qol.stats.Damage"}}
                            </div>
                            <div class="midi-stats-block-section midi-stats-session">
                                <div class="midi-stats-line">{{localize "midi-qol.stats.Avg"}}: {{this.session.damageTotalAverage}}</div>
                                <div class="midi-stats-line">{{localize "midi-qol.stats.Applied"}}: {{this.session.damageAppliedAverage}}</div>
                                <div class="midi-stats-line">{{localize "midi-qol.stats.maxHit"}}: {{this.session.maxDamage}}</div>
                                <div class="midi-stats-line">{{localize "midi-qol.stats.healed"}}: {{this.session.healingDone}}</div>
                                <div class="midi-stats-line">{{this.session.kills}} {{localize "midi-qol.stats.kills"}}</div>
                                {{#if this.sessionDamageDealtByType.length}}
                                    <div class="midi-stats-dmgtype-list midi-stats-dmgtype-dealt">
                                        <span class="midi-stats-dmgtype-label">{{localize "midi-qol.stats.rolled"}}:</span>
                                        {{#each this.sessionDamageDealtByType}}
                                            <span class="midi-stats-dmgtype-entry">{{this.type}}: {{this.amount}}</span>
                                        {{/each}}
                                    </div>
                                {{/if}}
                                {{#if this.sessionDamageAppliedByType.length}}
                                    <div class="midi-stats-dmgtype-list midi-stats-dmgtype-applied">
                                        <span class="midi-stats-dmgtype-label">{{localize "midi-qol.stats.applied"}}:</span>
                                        {{#each this.sessionDamageAppliedByType}}
                                            <span class="midi-stats-dmgtype-entry">{{this.type}}: {{this.amount}}</span>
                                        {{/each}}
                                    </div>
                                {{/if}}
                            </div>
                            <div class="midi-stats-block-section midi-stats-lifetime">
                                <div class="midi-stats-line">{{localize "midi-qol.stats.Avg"}}: {{this.lifetime.damageTotalAverage}}</div>
                                <div class="midi-stats-line">{{localize "midi-qol.stats.Applied"}}: {{this.lifetime.damageAppliedAverage}}</div>
                                <div class="midi-stats-line">{{localize "midi-qol.stats.maxHit"}}: {{this.lifetime.maxDamage}}</div>
                                <div class="midi-stats-line">{{localize "midi-qol.stats.healed"}}: {{this.lifetime.healingDone}}</div>
                                <div class="midi-stats-line">{{this.lifetime.kills}} {{localize "midi-qol.stats.kills"}}</div>
                                {{#if this.lifetimeDamageDealtByType.length}}
                                    <div class="midi-stats-dmgtype-list midi-stats-dmgtype-dealt">
                                        <span class="midi-stats-dmgtype-label">{{localize "midi-qol.stats.rolled"}}:</span>
                                        {{#each this.lifetimeDamageDealtByType}}
                                            <span class="midi-stats-dmgtype-entry">{{this.type}}: {{this.amount}}</span>
                                        {{/each}}
                                    </div>
                                {{/if}}
                                {{#if this.lifetimeDamageAppliedByType.length}}
                                    <div class="midi-stats-dmgtype-list midi-stats-dmgtype-applied">
                                        <span class="midi-stats-dmgtype-label">{{localize "midi-qol.stats.applied"}}:</span>
                                        {{#each this.lifetimeDamageAppliedByType}}
                                            <span class="midi-stats-dmgtype-entry">{{this.type}}: {{this.amount}}</span>
                                        {{/each}}
                                    </div>
                                {{/if}}
                            </div>
                        </div>

                        {{!-- Saves Block --}}
                        <div class="midi-stats-block">
                            <div class="midi-stats-block-title">
                                <i class="fas fa-shield-halved"></i> {{localize "midi-qol.stats.Saves"}}
                            </div>
                            <div class="midi-stats-block-section midi-stats-session">
                                <div class="midi-stats-line">{{this.session.numSaves}} {{localize "midi-qol.stats.total"}}</div>
                                <div class="midi-stats-line">
                                    <span class="midi-stats-pass">{{this.session.numSaveSuccess}} {{localize "midi-qol.stats.pass"}}</span>
                                    <span class="midi-stats-sep">/</span>
                                    <span class="midi-stats-fail">{{this.session.numSaveFail}} {{localize "midi-qol.stats.fail"}}</span>
                                </div>
                                <div class="midi-stats-line">{{localize "midi-qol.stats.conc"}}: {{this.session.numConcentrationSuccess}}/{{this.session.numConcentrationSaves}}</div>
                            </div>
                            <div class="midi-stats-block-section midi-stats-lifetime">
                                <div class="midi-stats-line">{{this.lifetime.numSaves}} {{localize "midi-qol.stats.total"}}</div>
                                <div class="midi-stats-line">
                                    <span class="midi-stats-pass">{{this.lifetime.numSaveSuccess}} {{localize "midi-qol.stats.pass"}}</span>
                                    <span class="midi-stats-sep">/</span>
                                    <span class="midi-stats-fail">{{this.lifetime.numSaveFail}} {{localize "midi-qol.stats.fail"}}</span>
                                </div>
                                <div class="midi-stats-line">{{localize "midi-qol.stats.conc"}}: {{this.lifetime.numConcentrationSuccess}}/{{this.lifetime.numConcentrationSaves}}</div>
                            </div>
                        </div>

                        {{!-- Defence Block --}}
                        <div class="midi-stats-block">
                            <div class="midi-stats-block-title">
                                <i class="fas fa-heart-pulse"></i> {{localize "midi-qol.stats.Defence"}}
                            </div>
                            <div class="midi-stats-block-section midi-stats-session">
                                <div class="midi-stats-line">{{localize "midi-qol.stats.Taken"}}: {{this.session.damageTaken}}</div>
                                {{#if this.sessionDamageTakenByType.length}}
                                    <div class="midi-stats-dmgtype-list">
                                        {{#each this.sessionDamageTakenByType}}
                                            <span class="midi-stats-dmgtype-entry">{{this.type}}: {{this.amount}}</span>
                                        {{/each}}
                                    </div>
                                {{/if}}
                            </div>
                            <div class="midi-stats-block-section midi-stats-lifetime">
                                <div class="midi-stats-line">{{localize "midi-qol.stats.Taken"}}: {{this.lifetime.damageTaken}}</div>
                                {{#if this.lifetimeDamageTakenByType.length}}
                                    <div class="midi-stats-dmgtype-list">
                                        {{#each this.lifetimeDamageTakenByType}}
                                            <span class="midi-stats-dmgtype-entry">{{this.type}}: {{this.amount}}</span>
                                        {{/each}}
                                    </div>
                                {{/if}}
                            </div>
                        </div>
                    </div>

                    {{#if this.hasItemStats}}
                        <div class="midi-stats-items-section" data-actor-id="{{@key}}">
                            <div class="midi-stats-items-header" data-action="toggleItems" data-actor-id="{{@key}}">
                                <i class="fas fa-chevron-right midi-stats-chevron"></i>
                                <span>{{localize "midi-qol.stats.ItemBreakdown"}}</span>
                            </div>
                            <div class="midi-stats-items-body">
                                <table class="midi-stats-items-table">
                                    <thead>
                                        <tr>
                                            <th class="midi-stats-item-col">{{localize "midi-qol.stats.Item"}}</th>
                                            <th>{{localize "midi-qol.stats.Rolls"}}</th>
                                            <th>{{localize "midi-qol.stats.Hits"}}</th>
                                            <th>{{localize "midi-qol.stats.Crits"}}</th>
                                            <th>{{localize "midi-qol.stats.AvgDmg"}}</th>
                                            <th>{{localize "midi-qol.stats.AppliedShort"}}</th>
                                            <th>{{localize "midi-qol.stats.SavesCol"}}</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {{#each this.itemStats}}
                                            <tr>
                                                <td class="midi-stats-item-col">{{this.name}}</td>
                                                <td>{{this.session.numAttacks}}</td>
                                                <td>{{this.session.numDamageRolls}}</td>
                                                <td>{{this.session.numAttackCritical}}</td>
                                                <td>{{this.session.damageTotalAverage}}</td>
                                                <td>{{this.session.damageAppliedAverage}}</td>
                                                <td>{{this.session.numSaveSuccess}}/{{this.session.numSaves}}</td>
                                            </tr>
                                        {{/each}}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    {{/if}}
                </div>
            </div>
        {{/each}}
    {{else}}
        <div class="midi-stats-empty">
            <i class="fas fa-chart-bar"></i>
            <span>{{localize "midi-qol.stats.NoStats"}}</span>
        </div>
    {{/if}}
</section>
