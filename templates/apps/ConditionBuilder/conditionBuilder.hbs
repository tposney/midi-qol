<div class="midi-qol-condition-builder-content">
<div class="midi-qol-condition-builder-body">
  <div class="midi-qol-condition-tree">
    {{#with tree}}{{> "modules/midi-qol/templates/apps/ConditionBuilder/conditionGroup.hbs"}}{{/with}}
  </div>
  <fieldset class="midi-qol-condition-result">
    <div class="form-group"><label>{{localize "midi-qol.ConditionBuilder.Reads"}}</label><div class="form-fields"><span class="midi-qol-condition-words">{{words}}</span></div></div>
    <div class="form-group"><label>{{localize "midi-qol.ConditionBuilder.Expression"}}</label><div class="form-fields"><code class="midi-qol-condition-expression">{{expression}}</code></div></div>
    {{#if problem}}<p class="midi-qol-condition-problem">{{problem}}</p>{{/if}}
  </fieldset>
</div>
<footer class="form-footer">
  <button type="button" data-action="save"><i class="fa-solid fa-check" inert></i> {{localize "midi-qol.ConditionBuilder.Save"}}</button>
</footer>
</div>
