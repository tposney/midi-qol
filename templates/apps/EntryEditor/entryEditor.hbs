<div class="midi-qol-entry-editor-root">
{{#if sheetHead}}
<header class="midi-qol-entry-sheet-head">
    <img src="{{sheetHead.img}}" data-action="editImage" data-edit="img" alt="" width="48" height="48">
    <div class="midi-qol-entry-sheet-name">
        <input type="text" name="sheetName" value="{{sheetHead.name}}" placeholder="{{localize "Name"}}">
        <details class="midi-qol-entry-sheet-description"><summary>{{localize "midi-qol.EntryEditor.Description"}}</summary>
            <prose-mirror name="sheetDescription" value="{{sheetHead.description}}" toggled>{{{sheetHead.enriched}}}</prose-mirror></details>
    </div>
</header>
{{/if}}
<nav class="midi-qol-entry-views">
    {{#each views}}<button type="button" data-action="setView" data-view="{{value}}" class="{{#if active}}active{{/if}}" aria-pressed="{{#if active}}true{{else}}false{{/if}}">{{label}}</button>{{/each}}
    <span class="midi-qol-entry-views-gap"></span>
    <button type="button" data-action="showRuns" class="{{#if showRuns}}active{{/if}}" data-tooltip="{{localize "midi-qol.EntryEditor.LastRunsHint"}}"><i class="fa-solid fa-clock-rotate-left"></i> {{localize "midi-qol.EntryEditor.LastRuns"}}</button>
</nav>
{{#if sentenceView}}
<div class="midi-qol-view-body {{#if pane}}with-pane{{/if}}">
<section class="midi-qol-entry-sentences scrollable">
    {{#with overlay}}
    <div class="midi-qol-entry-overlay">
        <div class="midi-qol-entry-choice-line"><i class="fa-solid fa-layer-group"></i> {{matches}}</div>
        {{#if base}}<div class="hint">{{base}}</div>{{/if}}
        {{#if baseChanged}}<div class="midi-qol-entry-warnings">{{localize "midi-qol.Overlay.Part.BaseChanged"}}</div>{{/if}}
        {{#if shows}}
        <div class="midi-qol-entry-overlay-shows">
            {{#each shows}}<button type="button" data-action="overlayShow" data-show="{{value}}" class="{{#if active}}active{{/if}}" aria-pressed="{{#if active}}true{{else}}false{{/if}}">{{label}}</button>{{/each}}
        </div>
        {{/if}}
        <details class="midi-qol-entry-overlay-changes">
            <summary>{{localize "midi-qol.Overlay.Part.ChangesCount" n=count}}</summary>
        {{#each groups}}
        <div class="midi-qol-entry-overlay-group">
            <div class="midi-qol-entry-overlay-group-label">{{label}}</div>
            {{#each rows}}
            <div class="midi-qol-entry-overlay-row" data-tooltip="{{key}}">
                <span class="midi-qol-entry-overlay-field">{{label}}</span>
                <span class="midi-qol-entry-overlay-value">{{#if code}}<code>{{words}}</code>{{else}}{{words}}{{/if}}</span>
                {{#if ../../editable}}<button type="button" class="midi-qol-entry-edit" data-action="overlayEditChange" data-index="{{index}}" data-tooltip="{{localize "midi-qol.Overlay.Part.Edit"}}" aria-label="{{localize "midi-qol.Overlay.Part.Edit"}}"><i class="fa-solid fa-pen"></i></button>
                <button type="button" class="midi-qol-entry-edit" data-action="overlayRemoveChange" data-index="{{index}}" data-tooltip="{{localize "midi-qol.Overlay.Part.Remove"}}" aria-label="{{localize "midi-qol.Overlay.Part.Remove"}}"><i class="fa-solid fa-trash"></i></button>{{/if}}
            </div>
            {{/each}}
        </div>
        {{/each}}
        {{#if parts.length}}<div class="midi-qol-entry-overlay-heading">{{localize "midi-qol.Overlay.Part.Carries"}}</div>{{/if}}
        {{#each parts}}<div class="midi-qol-entry-overlay-row"><span>{{this}}</span></div>{{/each}}
        </details>
        {{#unless editable}}<div class="hint">{{localize "midi-qol.Overlay.Part.Locked"}}</div>{{/unless}}
    </div>
    {{/with}}
    {{#if behaviour}}
    {{#with behaviour.header}}
    <div class="midi-qol-entry-home midi-qol-view-header" data-home="{{home}}">
        {{#if notice}}<div class="midi-qol-entry-choice-line midi-qol-entry-rule-notice"><i class="fa-solid fa-layer-group"></i> {{notice}}</div>{{/if}}
        {{#each ruleSentences}}
        <div class="midi-qol-entry-sentence midi-qol-entry-rule-sentence">
            <div class="midi-qol-entry-sentence-row">
                <span class="midi-qol-entry-number"><i class="fa-solid fa-layer-group"></i></span>
                <div class="midi-qol-entry-lines">
                    {{#each lines}}<div class="midi-qol-entry-line" style="padding-left: {{indent}}px"><span>{{text}}</span></div>{{/each}}
                    {{#if options}}<div class="midi-qol-entry-options">{{options}}</div>{{/if}}
                </div>
            </div>
        </div>
        {{/each}}
        {{#each choices}}<div class="midi-qol-entry-choice-line">{{this}}</div>{{/each}}
        {{> "modules/midi-qol/templates/apps/EntryEditor/settings.hbs"}}
        {{> "modules/midi-qol/templates/apps/EntryEditor/automationNotes.hbs"}}
    </div>
    {{/with}}
    {{#each behaviour.changed}}<div class="midi-qol-entry-line midi-qol-view-changed">{{text}}</div>{{/each}}
    {{#each behaviour.sections}}
    <section class="midi-qol-view-section midi-qol-view-{{id}}">
        <h4 class="midi-qol-view-section-label">{{label}}{{#if hint}} <span class="hint">{{hint}}</span>{{/if}}</h4>
        {{#if warning}}<div class="midi-qol-entry-warnings">{{warning}}</div>{{/if}}
        {{#each blocks}}{{> "modules/midi-qol/templates/apps/EntryEditor/useBlock.hbs"}}{{/each}}
        {{#if rows.length}}<div class="midi-qol-entry-home midi-qol-view-rows" data-home="{{@root.behaviour.header.home}}">{{#each rows}}{{> "modules/midi-qol/templates/apps/EntryEditor/sentenceRow.hbs"}}{{/each}}</div>{{/if}}
    </section>
    {{/each}}
    {{#with behaviour.header}}
    <div class="midi-qol-entry-home-buttons" data-home="{{home}}">
        <button type="button" data-action="showRecipes" data-home="{{home}}"><i class="fa-solid fa-plus"></i> {{localize "midi-qol.EntryEditor.AddRecipe"}}</button>
        <button type="button" data-action="add" data-home="{{home}}"><i class="fa-solid fa-plus"></i> {{localize "midi-qol.EntryEditor.AddBlank"}}</button>
    </div>
    {{#if recipes}}
    <div class="midi-qol-entry-picker midi-qol-entry-recipes">
        {{#each recipes}}<button type="button" data-action="useRecipe" data-home="{{home}}" data-recipe="{{id}}"><strong>{{label}}</strong><span>{{hint}}</span></button>{{/each}}
    </div>
    {{/if}}
    {{/with}}
    {{else}}
    {{#each sentences}}
    <div class="midi-qol-entry-home {{#unless (or sentences.length card automations.length settings effectSummary notice ruleSentences.length)}}empty{{/unless}}" data-home="{{home}}">
        {{#unless single}}<h4 class="midi-qol-entry-home-label">{{label}}{{#if effect}} <span class="hint">{{localize "midi-qol.EntryEditor.Home.effectHint"}}</span>{{/if}}</h4>{{/unless}}
        {{#if notice}}<div class="midi-qol-entry-choice-line midi-qol-entry-rule-notice"><i class="fa-solid fa-layer-group"></i> {{notice}}</div>{{/if}}
        {{#each ruleSentences}}
        <div class="midi-qol-entry-sentence midi-qol-entry-rule-sentence">
            <div class="midi-qol-entry-sentence-row">
                <span class="midi-qol-entry-number"><i class="fa-solid fa-layer-group"></i></span>
                <div class="midi-qol-entry-lines">
                    {{#each lines}}<div class="midi-qol-entry-line" style="padding-left: {{indent}}px"><span>{{text}}</span></div>{{/each}}
                    {{#if options}}<div class="midi-qol-entry-options">{{options}}</div>{{/if}}
                </div>
            </div>
        </div>
        {{/each}}
        {{#each choices}}<div class="midi-qol-entry-choice-line">{{this}}</div>{{/each}}
        {{> "modules/midi-qol/templates/apps/EntryEditor/settings.hbs"}}
        {{#with effectSummary}}<div class="midi-qol-entry-effect-summary"><button type="button" class="midi-qol-entry-edit" data-action="editEffect" data-home="{{../home}}" data-tooltip="{{localize "midi-qol.EntryEditor.Effect.Edit"}}" aria-label="{{localize "midi-qol.EntryEditor.Effect.Edit"}}"><i class="fa-solid fa-pen"></i></button>{{#if statuses}}<div>{{localize "midi-qol.EntryEditor.Effect.Statuses"}} {{statuses}}</div>{{/if}}{{#each changes}}<div><code>{{this}}</code></div>{{/each}}{{#if duration}}<div class="hint">{{localize "midi-qol.EntryEditor.Effect.Lasts"}} {{duration}}</div>{{/if}}</div>{{/with}}
        {{> "modules/midi-qol/templates/apps/EntryEditor/automationNotes.hbs"}}
        {{#with card}}{{> "modules/midi-qol/templates/apps/EntryEditor/activityCard.hbs"}}{{/with}}
        {{#each sentences}}{{> "modules/midi-qol/templates/apps/EntryEditor/sentenceRow.hbs"}}{{/each}}
        <div class="midi-qol-entry-home-buttons">
            <button type="button" data-action="showRecipes" data-home="{{home}}"><i class="fa-solid fa-plus"></i> {{localize "midi-qol.EntryEditor.AddRecipe"}}</button>
            <button type="button" data-action="add" data-home="{{home}}"><i class="fa-solid fa-plus"></i> {{localize "midi-qol.EntryEditor.AddBlank"}}</button>
        </div>
        {{#if recipes}}
        <div class="midi-qol-entry-picker midi-qol-entry-recipes">
            {{#each recipes}}<button type="button" data-action="useRecipe" data-home="{{home}}" data-recipe="{{id}}"><strong>{{label}}</strong><span>{{hint}}</span></button>{{/each}}
        </div>
        {{/if}}
    </div>
    {{/each}}
    {{/if}}
    {{#if addWhat}}
    <div class="midi-qol-entry-add-what">
        <button type="button" data-action="toggleAddWhat" class="{{#if addWhat.open}}active{{/if}}"><i class="fa-solid fa-plus"></i> {{localize "midi-qol.EntryEditor.AddWhat.button"}}</button>
        {{#if addWhat.open}}
        <div class="midi-qol-entry-picker midi-qol-entry-recipes">
            {{#each addWhat.kinds}}<button type="button" data-action="addWhat" data-kind="{{value}}"><strong>{{label}}</strong><span>{{hint}}</span></button>{{/each}}
        </div>
        {{/if}}
    </div>
    {{/if}}
</section>
{{#if pane}}
<aside class="midi-qol-view-pane scrollable">
    <div class="midi-qol-view-pane-head">
        <strong>{{pane.label}}</strong>
        <span class="midi-qol-entry-views-gap"></span>
        {{#if pane.entry}}<span class="midi-qol-entry-move">
            {{#unless pane.first}}<button type="button" data-action="moveEntry" data-home="{{pane.at}}" data-index="{{pane.index}}" data-dir="up" data-tooltip="{{localize "midi-qol.EntryEditor.MoveUp"}}"><i class="fa-solid fa-arrow-up"></i></button>{{/unless}}
            {{#unless pane.last}}<button type="button" data-action="moveEntry" data-home="{{pane.at}}" data-index="{{pane.index}}" data-dir="down" data-tooltip="{{localize "midi-qol.EntryEditor.MoveDown"}}"><i class="fa-solid fa-arrow-down"></i></button>{{/unless}}
        </span>{{/if}}
        <button type="button" data-action="closePane" data-tooltip="{{localize "Close"}}" aria-label="{{localize "Close"}}"><i class="fa-solid fa-xmark"></i></button>
    </div>
    {{#if pane.home}}{{> "modules/midi-qol/templates/apps/EntryEditor/homePane.hbs"}}{{/if}}
    {{#if pane.entry}}<div class="midi-qol-entry-inline">{{> "modules/midi-qol/templates/apps/EntryEditor/entryForm.hbs"}}</div>{{/if}}
</aside>
{{/if}}
</div>
{{else}}
<div class="midi-qol-entry-editor-body">
    <nav class="midi-qol-entry-list scrollable">
        {{#each list}}
        {{#unless single}}<a class="midi-qol-entry-home-pick {{#if active}}active{{/if}}" data-action="select" data-home="{{home}}" data-index="0">{{label}}</a>{{/unless}}
        <ul>
            {{#each entries}}
            <li class="{{#if selected}}active{{/if}} {{#if invalid}}invalid{{/if}}">
                <a data-action="select" data-home="{{home}}" data-index="{{index}}"><strong>{{id}}</strong> <span>{{on}}</span></a>
                <span class="midi-qol-entry-move">
                    {{#unless first}}<button type="button" data-action="moveEntry" data-home="{{home}}" data-index="{{index}}" data-dir="up" data-tooltip="{{localize "midi-qol.EntryEditor.MoveUp"}}"><i class="fa-solid fa-arrow-up"></i></button>{{/unless}}
                    {{#unless last}}<button type="button" data-action="moveEntry" data-home="{{home}}" data-index="{{index}}" data-dir="down" data-tooltip="{{localize "midi-qol.EntryEditor.MoveDown"}}"><i class="fa-solid fa-arrow-down"></i></button>{{/unless}}
                </span>
            </li>
            {{/each}}
        </ul>
        {{/each}}
        <button type="button" data-action="add"><i class="fa-solid fa-plus"></i> {{localize "midi-qol.EntryEditor.Add"}}</button>
    </nav>
    <section class="midi-qol-entry-form scrollable">
        {{#if homeLabel}}<h4 class="midi-qol-entry-home-label">{{homeLabel}}</h4>{{/if}}
        {{> "modules/midi-qol/templates/apps/EntryEditor/homePane.hbs"}}
        {{> "modules/midi-qol/templates/apps/EntryEditor/automationNotes.hbs"}}
        {{#with activityCard}}{{> "modules/midi-qol/templates/apps/EntryEditor/activityCard.hbs"}}{{/with}}
        {{#if hasEntry}}
        {{> "modules/midi-qol/templates/apps/EntryEditor/entryForm.hbs"}}
        {{else}}
        <p>{{localize "midi-qol.EntryEditor.None"}}</p>
        {{/if}}
        {{#if overtime}}
        <fieldset class="midi-qol-entry-overtime">
            <legend>{{localize "midi-qol.EntryEditor.OverTime"}}</legend>
            <p class="hint">{{localize "midi-qol.EntryEditor.OverTimeHint"}}</p>
            <textarea rows="8" readonly spellcheck="false">{{overtime}}</textarea>
        </fieldset>
        {{/if}}
    </section>
</div>
{{/if}}
<footer class="form-footer">
    <button type="button" data-action="save" {{#unless canSave}}disabled{{/unless}}><i class="fa-solid fa-floppy-disk"></i> {{localize "midi-qol.EntryEditor.Save"}}</button>
</footer>
</div>
