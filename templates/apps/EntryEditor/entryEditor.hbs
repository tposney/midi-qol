<div class="midi-qol-entry-editor-root">
<div class="midi-qol-entry-editor-body">
    <nav class="midi-qol-entry-list scrollable">
        <ul>
            {{#each list}}
            <li class="{{#if selected}}active{{/if}} {{#if invalid}}invalid{{/if}}">
                <a data-action="select" data-index="{{index}}"><strong>{{id}}</strong> <span>{{on}}</span></a>
            </li>
            {{/each}}
        </ul>
        <button type="button" data-action="add"><i class="fa-solid fa-plus"></i> {{localize "midi-qol.EntryEditor.Add"}}</button>
    </nav>
    <section class="midi-qol-entry-form scrollable">
        {{#if hasEntry}}
        <div class="midi-qol-entry-toolbar">
            <button type="button" data-action="toggleJson">{{#if jsonView}}{{localize "midi-qol.EntryEditor.Form"}}{{else}}{{localize "midi-qol.EntryEditor.Json"}}{{/if}}</button>
            <button type="button" data-action="remove"><i class="fa-solid fa-trash"></i> {{localize "midi-qol.EntryEditor.Remove"}}</button>
        </div>
        {{#if problems.length}}
        <ul class="midi-qol-entry-problems">{{#each problems}}<li>{{this}}</li>{{/each}}</ul>
        {{/if}}
        {{#if jsonView}}
        <textarea name="json" rows="24" spellcheck="false">{{json}}</textarea>
        {{else}}
        <div class="form-group"><label>{{localize "midi-qol.EntryEditor.Field.id"}}</label><input type="text" name="id" value="{{entry.id}}"></div>
        <div class="form-group"><label>{{localize "midi-qol.EntryEditor.Field.on"}}</label>
            <multi-select name="on">{{#each events}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</multi-select></div>
        <div class="form-group"><label>{{localize "midi-qol.EntryEditor.Field.who"}}</label>
            <select name="who">{{#each who}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></div>
        {{#if near}}
        <div class="form-group"><label>{{localize "midi-qol.EntryEditor.Field.within"}}</label><input type="text" name="within" value="{{near.within}}"></div>
        <div class="form-group"><label>{{localize "midi-qol.EntryEditor.Field.of"}}</label><input type="text" name="of" value="{{near.of}}"></div>
        <div class="form-group"><label>{{localize "midi-qol.EntryEditor.Field.filter"}}</label><input type="text" name="filter" value="{{near.filter}}"></div>
        {{/if}}
        <div class="form-group"><label>{{localize "midi-qol.EntryEditor.Field.label"}}</label><input type="text" name="label" value="{{entry.label}}"></div>
        <div class="form-group"><label>{{localize "midi-qol.EntryEditor.Field.if"}}</label><textarea name="if" rows="2" spellcheck="false">{{entry.if}}</textarea></div>
        <div class="form-group"><label>{{localize "midi-qol.EntryEditor.Field.offer"}}</label>
            <select name="offer">{{#each offers}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></div>
        <div class="form-group"><label>{{localize "midi-qol.EntryEditor.Field.activity"}}</label>
            <select name="activity">{{#each activities}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></div>
        <div class="form-group"><label>{{localize "midi-qol.EntryEditor.Field.limit"}}</label>
            <select name="limitPer">{{#each limits}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
            <input type="number" name="limitMax" value="{{entry.limit.max}}" min="1" step="1"></div>
        <div class="form-group"><label>{{localize "midi-qol.EntryEditor.Field.group"}}</label><input type="text" name="group" value="{{entry.group}}">
            <label class="checkbox"><input type="checkbox" name="stacks" {{#if entry.stacks}}checked{{/if}}> {{localize "midi-qol.EntryEditor.Field.stacks"}}</label></div>
        <div class="form-group stacked"><label>{{localize "midi-qol.EntryEditor.Field.do"}}</label>
            {{#if cardsShown}}
            {{#each actionCards}}
            <div class="midi-qol-entry-action">
                <div class="midi-qol-entry-action-head">
                    <select name="act.{{index}}.kind"><option value="" {{#unless key}}selected{{/unless}}>?</option>{{#each kinds}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
                    <button type="button" data-action="removeAction" data-index="{{index}}" data-tooltip="{{localize "midi-qol.EntryEditor.Remove"}}"><i class="fa-solid fa-trash"></i></button>
                </div>
                {{#if fields}}
                {{#each fields}}
                <div class="form-group"><label>{{localize label}}</label>
                    {{#if (eq type "select")}}<select name="{{name}}">{{#each options}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
                    {{else if (eq type "boolean")}}<input type="checkbox" name="{{name}}" {{#if checked}}checked{{/if}}>
                    {{else if (eq type "number")}}<input type="number" name="{{name}}" value="{{value}}">
                    {{else}}<input type="text" name="{{name}}" value="{{value}}">{{/if}}
                </div>
                {{/each}}
                {{else}}
                <textarea name="act.{{index}}.json" rows="4" spellcheck="false">{{json}}</textarea>
                {{/if}}
            </div>
            {{/each}}
            <button type="button" data-action="addAction"><i class="fa-solid fa-plus"></i> {{localize "midi-qol.EntryEditor.AddAction"}}</button>
            {{else}}
            <textarea name="do" rows="10" spellcheck="false">{{rawDo}}</textarea>
            {{/if}}
        </div>
        <div class="form-group stacked"><label>{{localize "midi-qol.EntryEditor.Field.choose"}}</label><textarea name="choose" rows="3" spellcheck="false">{{rawChoose}}</textarea></div>
        {{/if}}
        {{else}}
        <p>{{localize "midi-qol.EntryEditor.None"}}</p>
        {{/if}}
        {{#if overtime}}
        <fieldset class="midi-qol-entry-overtime">
            <legend>{{localize "midi-qol.EntryEditor.OverTime"}}</legend>
            <p class="hint">{{localize "midi-qol.EntryEditor.OverTimeHint"}}</p>
            <textarea rows="8" readonly spellcheck="false">{{overtime}}</textarea>
        </fieldset>
        {{/if}}
    </section>
</div>
<footer class="form-footer">
    <button type="button" data-action="save" {{#unless canSave}}disabled{{/unless}}><i class="fa-solid fa-floppy-disk"></i> {{localize "midi-qol.EntryEditor.Save"}}</button>
</footer>
</div>
