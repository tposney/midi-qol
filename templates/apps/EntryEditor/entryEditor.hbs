<div class="midi-qol-entry-editor-root">
<nav class="midi-qol-entry-views">
    {{#each views}}<button type="button" data-action="setView" data-view="{{value}}" class="{{#if active}}active{{/if}}" aria-pressed="{{#if active}}true{{else}}false{{/if}}">{{label}}</button>{{/each}}
    <span class="midi-qol-entry-views-gap"></span>
    <button type="button" data-action="showRuns" class="{{#if showRuns}}active{{/if}}" data-tooltip="{{localize "midi-qol.EntryEditor.LastRunsHint"}}"><i class="fa-solid fa-clock-rotate-left"></i> {{localize "midi-qol.EntryEditor.LastRuns"}}</button>
</nav>
{{#if sentenceView}}
<section class="midi-qol-entry-sentences scrollable">
    {{#each sentences}}
    <div class="midi-qol-entry-home {{#unless (or sentences.length card automations.length)}}empty{{/unless}}" data-home="{{home}}">
        {{#unless single}}<h4 class="midi-qol-entry-home-label">{{label}}{{#if effect}} <span class="hint">{{localize "midi-qol.EntryEditor.Home.effectHint"}}</span>{{/if}}</h4>{{/unless}}
        {{#each choices}}<div class="midi-qol-entry-choice-line">{{this}}</div>{{/each}}
        {{> "modules/midi-qol/templates/apps/EntryEditor/automationNotes.hbs"}}
        {{#with card}}{{> "modules/midi-qol/templates/apps/EntryEditor/activityCard.hbs"}}{{/with}}
        {{#each sentences}}
        <div class="midi-qol-entry-sentence {{#if problems.length}}invalid{{/if}}">
            <div class="midi-qol-entry-sentence-row">
                <span class="midi-qol-entry-number">{{number}}</span>
                <div class="midi-qol-entry-lines">
                    {{#each lines}}
                    <div class="midi-qol-entry-line" style="padding-left: {{indent}}px">{{#each parts}}{{#if kind}}<button type="button" class="midi-qol-entry-chip {{kind}} {{#if code}}code{{/if}}" data-action="focusPart" data-home="{{home}}" data-index="{{index}}" data-focus="{{focus}}">{{text}}</button>{{else}}<span>{{text}}</span>{{/if}} {{/each}}</div>
                    {{/each}}
                    {{#if options}}<div class="midi-qol-entry-options">{{options}}</div>{{/if}}
                    {{#if run}}<div class="midi-qol-entry-run"><i class="fa-solid fa-clock-rotate-left"></i> {{run}}</div>{{/if}}
                    {{#if problems.length}}<ul class="midi-qol-entry-problems">{{#each problems}}<li>{{this}}</li>{{/each}}</ul>{{/if}}
                </div>
                <button type="button" class="midi-qol-entry-edit" data-action="editEntry" data-home="{{home}}" data-index="{{index}}" data-tooltip="{{localize "midi-qol.EntryEditor.Edit"}}" aria-label="{{localize "midi-qol.EntryEditor.Edit"}}" aria-expanded="{{#if expanded}}true{{else}}false{{/if}}"><i class="fa-solid {{#if expanded}}fa-chevron-up{{else}}fa-pen{{/if}}"></i></button>
            </div>
            {{#if expanded}}
            <div class="midi-qol-entry-inline">
        {{> "modules/midi-qol/templates/apps/EntryEditor/entryForm.hbs" @root}}
            </div>
            {{/if}}
            {{#if picker}}
            <div class="midi-qol-entry-picker">
                <div class="midi-qol-entry-picker-head"><strong>{{localize "midi-qol.EntryEditor.PickTrigger"}}</strong> <span class="hint">{{localize "midi-qol.EntryEditor.PickTriggerHint"}}</span>
                    <button type="button" data-action="closePicker" aria-label="{{localize "Close"}}"><i class="fa-solid fa-xmark"></i></button></div>
                {{#each picker}}
                <div class="midi-qol-entry-picker-group">{{label}}</div>
                <div class="midi-qol-entry-picker-choices">
                    {{#each choices}}<button type="button" class="{{#if selected}}active{{/if}}" data-action="setTrigger" data-home="{{home}}" data-index="{{index}}" data-event="{{event}}" {{#if setsWho}}data-who="{{who}}"{{/if}}>{{label}}</button>{{/each}}
                </div>
                {{/each}}
            </div>
            {{/if}}
        </div>
        {{/each}}
        <div class="midi-qol-entry-home-buttons">
            <button type="button" data-action="showRecipes" data-home="{{home}}"><i class="fa-solid fa-plus"></i> {{localize "midi-qol.EntryEditor.AddRecipe"}}</button>
            <button type="button" data-action="add" data-home="{{home}}"><i class="fa-solid fa-plus"></i> {{localize "midi-qol.EntryEditor.AddBlank"}}</button>
        </div>
        {{#if recipes}}
        <div class="midi-qol-entry-picker midi-qol-entry-recipes">
            {{#each recipes}}<button type="button" data-action="useRecipe" data-home="{{home}}" data-recipe="{{id}}"><strong>{{label}}</strong><span>{{hint}}</span></button>{{/each}}
        </div>
        {{/if}}
    </div>
    {{/each}}
</section>
{{else}}
<div class="midi-qol-entry-editor-body">
    <nav class="midi-qol-entry-list scrollable">
        {{#each list}}
        {{#unless single}}<a class="midi-qol-entry-home-pick {{#if active}}active{{/if}}" data-action="select" data-home="{{home}}" data-index="0">{{label}}</a>{{/unless}}
        <ul>
            {{#each entries}}
            <li class="{{#if selected}}active{{/if}} {{#if invalid}}invalid{{/if}}">
                <a data-action="select" data-home="{{home}}" data-index="{{index}}"><strong>{{id}}</strong> <span>{{on}}</span></a>
                <span class="midi-qol-entry-move">
                    {{#unless first}}<button type="button" data-action="moveEntry" data-home="{{home}}" data-index="{{index}}" data-dir="up" data-tooltip="{{localize "midi-qol.EntryEditor.MoveUp"}}"><i class="fa-solid fa-arrow-up"></i></button>{{/unless}}
                    {{#unless last}}<button type="button" data-action="moveEntry" data-home="{{home}}" data-index="{{index}}" data-dir="down" data-tooltip="{{localize "midi-qol.EntryEditor.MoveDown"}}"><i class="fa-solid fa-arrow-down"></i></button>{{/unless}}
                </span>
            </li>
            {{/each}}
        </ul>
        {{/each}}
        <button type="button" data-action="add"><i class="fa-solid fa-plus"></i> {{localize "midi-qol.EntryEditor.Add"}}</button>
    </nav>
    <section class="midi-qol-entry-form scrollable">
        {{#if homeLabel}}<h4 class="midi-qol-entry-home-label">{{homeLabel}}</h4>{{/if}}
        {{#if homeChoices}}
        <div class="form-group stacked"><label>{{localize "midi-qol.EntryEditor.Field.homeChoices"}}</label><textarea name="homeChoices" rows="4" spellcheck="false">{{homeChoices}}</textarea>
            {{#if homeChoicesProblem}}<ul class="midi-qol-entry-problems"><li>{{homeChoicesProblem}}</li></ul>{{/if}}</div>
        {{/if}}
        {{> "modules/midi-qol/templates/apps/EntryEditor/automationNotes.hbs"}}
        {{#with activityCard}}{{> "modules/midi-qol/templates/apps/EntryEditor/activityCard.hbs"}}{{/with}}
        {{#if hasEntry}}
        {{> "modules/midi-qol/templates/apps/EntryEditor/entryForm.hbs"}}
        {{else}}
        <p>{{localize "midi-qol.EntryEditor.None"}}</p>
        {{/if}}
        {{#if overtime}}
        <fieldset class="midi-qol-entry-overtime">
            <legend>{{localize "midi-qol.EntryEditor.OverTime"}}</legend>
            <p class="hint">{{localize "midi-qol.EntryEditor.OverTimeHint"}}</p>
            <textarea rows="8" readonly spellcheck="false">{{overtime}}</textarea>
        </fieldset>
        {{/if}}
    </section>
</div>
{{/if}}
<footer class="form-footer">
    <button type="button" data-action="save" {{#unless canSave}}disabled{{/unless}}><i class="fa-solid fa-floppy-disk"></i> {{localize "midi-qol.EntryEditor.Save"}}</button>
</footer>
</div>
