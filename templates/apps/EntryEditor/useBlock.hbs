<div class="midi-qol-view-block midi-qol-entry-home {{#if nested}}nested{{/if}} {{#if mark}}midi-qol-view-{{mark}}{{/if}}" data-home="{{home}}">
    <div class="midi-qol-view-head"><span class="midi-qol-view-name">{{label}}</span>{{#if note}} <span class="hint">{{note}}</span>{{/if}}<span class="midi-qol-entry-views-gap"></span>{{#if cost}}<span class="midi-qol-view-cost">{{cost}}</span>{{/if}}{{#if canAdd}}<button type="button" class="midi-qol-entry-edit" data-action="editHome" data-home="{{home}}" data-tooltip="{{localize "midi-qol.ItemView.EditHome"}}" aria-label="{{localize "midi-qol.ItemView.EditHome"}}"><i class="fa-solid fa-sliders"></i></button>{{/if}}</div>
    {{#if trigger}}<div class="midi-qol-entry-line midi-qol-view-trigger {{#if trigger.by}}midi-qol-view-set{{/if}}"><span class="midi-qol-view-lab">{{localize "midi-qol.ItemView.Trigger"}}</span> {{#if trigger.editable}}<button type="button" class="midi-qol-entry-chip who {{#if trigger.code}}code{{/if}}" data-action="editTrigger" data-home="{{home}}">{{trigger.words}}</button>{{else}}{{#if trigger.code}}<code>{{trigger.words}}</code>{{else}}<span>{{trigger.words}}</span>{{/if}}{{/if}}{{#if trigger.by}} <span class="hint"><i class="fa-solid fa-layer-group"></i> {{trigger.by}}</span>{{/if}}</div>
    {{#if card}}<div class="midi-qol-entry-line"><span class="midi-qol-view-lab">{{localize "midi-qol.ItemView.Response"}}</span></div>{{/if}}{{/if}}
    {{#if mark}}<div class="midi-qol-view-mark">{{localize "midi-qol.ItemView.Added"}}</div>{{/if}}
    {{#each changed}}<div class="midi-qol-entry-line midi-qol-view-changed">{{text}}</div>{{/each}}
    {{#each enchanted}}<div class="midi-qol-entry-line midi-qol-view-set"><i class="fa-solid fa-layer-group"></i> {{text}}</div>{{/each}}
    {{#each choices}}<div class="midi-qol-entry-choice-line">{{this}}</div>{{/each}}
    {{#each lines}}<div class="midi-qol-entry-line"><span class="midi-qol-view-lab">{{lab}}</span> <span>{{text}}</span></div>{{/each}}
    {{#with effectSummary}}<div class="midi-qol-entry-effect-summary"><button type="button" class="midi-qol-entry-edit" data-action="editEffect" data-home="{{../home}}" data-tooltip="{{localize "midi-qol.EntryEditor.Effect.Edit"}}" aria-label="{{localize "midi-qol.EntryEditor.Effect.Edit"}}"><i class="fa-solid fa-pen"></i></button>{{#if statuses}}<div>{{localize "midi-qol.EntryEditor.Effect.Statuses"}} {{statuses}}</div>{{/if}}{{#each changes}}<div><code>{{this}}</code></div>{{/each}}{{#if duration}}<div class="hint">{{localize "midi-qol.EntryEditor.Effect.Lasts"}} {{duration}}</div>{{/if}}</div>{{/with}}
    {{> "modules/midi-qol/templates/apps/EntryEditor/automationNotes.hbs"}}
    {{#with card}}{{> "modules/midi-qol/templates/apps/EntryEditor/activityCard.hbs"}}{{/with}}
    {{#each rows}}{{> "modules/midi-qol/templates/apps/EntryEditor/sentenceRow.hbs"}}{{/each}}
    {{#each launches}}{{> "modules/midi-qol/templates/apps/EntryEditor/launch.hbs"}}{{/each}}
    {{#if canAdd}}
    <div class="midi-qol-entry-home-buttons">
        <button type="button" data-action="showRecipes" data-home="{{home}}"><i class="fa-solid fa-plus"></i> {{localize "midi-qol.EntryEditor.AddRecipe"}}</button>
        <button type="button" data-action="add" data-home="{{home}}"><i class="fa-solid fa-plus"></i> {{localize "midi-qol.EntryEditor.AddBlank"}}</button>
    </div>
    {{#if recipes}}
    <div class="midi-qol-entry-picker midi-qol-entry-recipes">
        {{#each recipes}}<button type="button" data-action="useRecipe" data-home="{{home}}" data-recipe="{{id}}"><strong>{{label}}</strong><span>{{hint}}</span></button>{{/each}}
    </div>
    {{/if}}
    {{/if}}
</div>
