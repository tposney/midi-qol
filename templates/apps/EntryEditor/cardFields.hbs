        {{#if target}}
        <div class="form-group">
            <label>{{localize "midi-qol.EntryEditor.Activity.TargetField"}}</label>
            <div class="form-fields"><select name="card.target.preset">{{#each target.presets}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></div>
        </div>
        {{#if target.custom}}<p class="hint">{{localize "midi-qol.EntryEditor.Activity.TargetCustom"}}</p>{{/if}}
        {{#if target.count}}<div class="form-group"><label>{{localize "midi-qol.EntryEditor.Activity.TargetCount"}}</label><div class="form-fields"><input type="number" name="card.target.count" value="{{target.count}}" min="1" step="1"></div></div>{{/if}}
        {{#if target.shapes}}<div class="form-group"><label>{{localize "midi-qol.EntryEditor.Activity.TargetShape"}}</label><div class="form-fields"><select name="card.target.shape">{{#each target.shapes}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></div></div>{{/if}}
        {{#if target.hasSize}}<div class="form-group"><label>{{localize "midi-qol.EntryEditor.Activity.TargetSize"}}</label><div class="form-fields"><input type="number" name="card.target.size" value="{{target.size}}" min="0" step="5"></div></div>{{/if}}
        {{#if target.hasWidth}}<div class="form-group"><label>{{localize "midi-qol.EntryEditor.Activity.TargetWidth"}}</label><div class="form-fields"><input type="number" name="card.target.width" value="{{target.width}}" min="0" step="5"></div></div>{{/if}}
        {{#if target.hasRange}}<div class="form-group"><label>{{localize "midi-qol.EntryEditor.Activity.TargetRange"}}</label><div class="form-fields"><input type="number" name="card.target.range" value="{{target.range}}" min="0" step="5"></div></div>{{/if}}
        {{#if target.canLinger}}<div class="form-group"><label></label><div class="form-fields"><label class="checkbox"><input type="checkbox" name="card.area.lingers" {{#if target.lingers}}checked{{/if}}> {{localize "midi-qol.EntryEditor.Activity.Area.lingers"}}</label></div></div>{{/if}}
        {{#if target.who}}<div class="form-group"><label>{{localize "midi-qol.EntryEditor.Activity.TargetWho"}}</label><div class="form-fields"><select name="card.target.who">{{#each target.who}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></div></div>{{/if}}
        {{/if}}
        {{#if onUse}}
        <div class="form-group"><label>{{localize "midi-qol.EntryEditor.OnUse.macro"}}</label><div class="form-fields">
            <input type="text" name="card.onuse.name" value="{{onUse.name}}" list="midi-qol-onuse-macros">
            <datalist id="midi-qol-onuse-macros">{{#each onUse.macros}}<option value="{{value}}">{{label}}</option>{{/each}}</datalist></div></div>
        <div class="form-group"><label>{{localize "midi-qol.EntryEditor.OnUse.when"}}</label><div class="form-fields"><select name="card.onuse.option">{{#each onUse.passes}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></div></div>
        <p class="hint">{{localize "midi-qol.EntryEditor.OnUse.hint"}}</p>
        <button type="button" data-action="removeOnUse" data-index="{{onUse.index}}"><i class="fa-solid fa-trash"></i> {{localize "midi-qol.EntryEditor.Activity.Area.remove"}}</button>
        {{/if}}
        {{#if basics}}
        <div class="form-group"><label>{{localize "midi-qol.EntryEditor.Activity.Basics.activation"}}</label><div class="form-fields">
            {{#if basics.hasActivationValue}}<input type="number" name="card.basics.activationValue" value="{{basics.activationValue}}" min="1" step="1">{{/if}}
            <select name="card.basics.activation">{{#each basics.activation}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></div></div>
        <div class="form-group"><label>{{localize "midi-qol.EntryEditor.Activity.Basics.duration"}}</label><div class="form-fields">
            {{#if basics.scalar}}<input type="text" name="card.basics.durationValue" value="{{basics.durationValue}}">{{/if}}
            <select name="card.basics.durationUnits">{{#each basics.units}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></div></div>
        <div class="form-group"><label></label><div class="form-fields"><label class="checkbox"><input type="checkbox" name="card.basics.concentration" {{#if basics.concentration}}checked{{/if}}> {{localize "midi-qol.EntryEditor.Activity.Basics.concentration"}}</label></div></div>
        <div class="form-group"><label>{{localize "midi-qol.EntryEditor.Activity.Basics.uses"}}</label><div class="form-fields">
            {{#if basics.hasMax}}<input type="text" name="card.basics.usesMax" value="{{basics.usesMax}}">{{/if}}
            {{#if basics.isRecharge}}<select name="card.basics.recharge">{{#each basics.recharge}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>{{/if}}
            <select name="card.basics.usesPeriod">{{#each basics.uses}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></div></div>
        {{#each basics.extra}}
        <div class="form-group"><label>{{#unless isCheckbox}}{{label}}{{/unless}}</label><div class="form-fields">
            {{#if isSelect}}<select name="card.basicsx.{{id}}">{{#each options}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
            {{else if isCheckbox}}<label class="checkbox"><input type="checkbox" name="card.basicsx.{{id}}" {{#if checked}}checked{{/if}}> {{label}}</label>
            {{else}}<input type="{{#if isNumber}}number{{else}}text{{/if}}" name="card.basicsx.{{id}}" value="{{value}}">{{/if}}</div></div>
        {{/each}}
        {{/if}}
        {{#if area}}
        <div class="form-group"><label></label><div class="form-fields"><label class="checkbox"><input type="checkbox" name="card.area.lingers" {{#if area.lingers}}checked{{/if}}> {{localize "midi-qol.EntryEditor.Activity.Area.lingers"}}</label></div></div>
        <div class="form-group"><label>{{localize "midi-qol.EntryEditor.Activity.Area.attachLabel"}}</label><div class="form-fields"><select name="card.area.attach">{{#each area.attach}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></div></div>
        <div class="form-group"><label>{{localize "midi-qol.EntryEditor.Activity.Area.whoLabel"}}</label><div class="form-fields"><select name="card.area.who">{{#each area.who}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></div></div>
        <div class="form-group"><label></label><div class="form-fields"><label class="checkbox"><input type="checkbox" name="card.area.once" {{#if area.once}}checked{{/if}}> {{localize "midi-qol.EntryEditor.Activity.Area.once"}}</label></div></div>
        {{/if}}
        {{#if areaGroup}}
        <div class="form-group"><label>{{localize "midi-qol.EntryEditor.Activity.Area.kindLabel"}}</label><div class="form-fields"><select name="card.area.g.kind">{{#each areaGroup.kinds}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></div></div>
        <div class="form-group"><label>{{#if areaGroup.isUse}}{{localize "midi-qol.EntryEditor.Activity.Area.useLabel"}}{{else}}{{localize "midi-qol.EntryEditor.Activity.EffectWhat"}}{{/if}}</label><div class="form-fields"><select name="card.area.g.target">{{#each areaGroup.targets}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></div></div>
        {{#if areaGroup.triggers}}<div class="form-group"><label>{{localize "midi-qol.EntryEditor.Activity.Area.whenLabel"}}</label><div class="form-fields midi-qol-area-triggers">{{#each areaGroup.triggers}}<label class="checkbox"><input type="checkbox" name="card.area.g.trigger.{{value}}" {{#if checked}}checked{{/if}}> {{label}}</label>{{/each}}</div></div>{{/if}}
        <button type="button" data-action="removeAreaGroup" data-home="{{home}}" data-index="{{areaGroup.index}}"><i class="fa-solid fa-trash"></i> {{localize "midi-qol.EntryEditor.Activity.Area.remove"}}</button>
        {{/if}}
        {{#if roll}}
        <div class="form-group">
            <label>{{localize "midi-qol.EntryEditor.Activity.RollField"}}</label>
            <div class="form-fields"><select name="card.rollKind">{{#each roll.kinds}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></div>
        </div>
        {{#if roll.attack}}
        <div class="form-group">
            <label>{{localize "midi-qol.EntryEditor.Activity.AttackField"}}</label>
            <div class="form-fields">
                <select name="card.attackType">{{#each roll.attack.types}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
                <select name="card.attackClass">{{#each roll.attack.classes}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
            </div>
        </div>
        {{/if}}
        {{/if}}
        {{#each contributed}}
        <div class="form-group">
            <label>{{localize label}}</label>
            <div class="form-fields">
                {{#if isSelect}}<select name="{{field}}">{{#each options}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
                {{else if isCheckbox}}<input type="checkbox" name="{{field}}" {{#if checked}}checked{{/if}}>
                {{else if isNumber}}<input type="number" name="{{field}}" value="{{value}}">
                {{else}}<input type="text" name="{{field}}" value="{{value}}">{{/if}}
            </div>
        </div>
        {{/each}}
        {{#if check}}
        <div class="form-group">
            <label>{{localize "midi-qol.EntryEditor.Activity.CheckField"}}</label>
            <div class="form-fields"><select name="card.checkAbility">{{#each check.abilities}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></div>
        </div>
        <div class="form-group">
            <label>{{localize "midi-qol.EntryEditor.Activity.DCField.label"}}</label>
            <div class="form-fields">
                <select name="card.dcCalculation">{{#each check.calculations}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
                {{#if check.custom}}<input type="text" name="card.dcFormula" value="{{check.formula}}" placeholder="15">{{/if}}
            </div>
        </div>
        {{/if}}
        {{#if save}}
        <div class="form-group">
            <label>{{localize "midi-qol.EntryEditor.Activity.SaveField"}}</label>
            <div class="form-fields"><select name="card.saveAbility" multiple>{{#each save.abilities}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></div>
        </div>
        <div class="form-group">
            <label>{{localize "midi-qol.EntryEditor.Activity.DCField.label"}}</label>
            <div class="form-fields">
                <select name="card.dcCalculation">{{#each save.calculations}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
                {{#if save.custom}}<input type="text" name="card.dcFormula" value="{{save.formula}}" placeholder="15">{{/if}}
            </div>
        </div>
        {{#if save.onSave}}
        <div class="form-group">
            <label>{{localize "midi-qol.EntryEditor.Activity.OnSave.label"}}</label>
            <div class="form-fields"><select name="card.onSave">{{#each save.onSave}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></div>
        </div>
        {{/if}}
        {{/if}}
        {{#if parts}}
        {{#each parts}}
        <div class="form-group">
            <label>{{localize "midi-qol.EntryEditor.Activity.DamageField"}}</label>
            <div class="form-fields">
                <input type="text" name="card.part.{{i}}.formula" value="{{formula}}">
                <select name="card.part.{{i}}.types" multiple class="midi-qol-entry-multiselect">{{#each types}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
            </div>
        </div>
        {{#if scaling}}
        <div class="form-group"><label>{{localize "midi-qol.EntryEditor.Activity.Scaling.label"}}</label><div class="form-fields">
            {{#if scaling.on}}<input type="number" name="card.part.{{i}}.scaling.number" value="{{scaling.number}}" min="1" step="1">{{/if}}
            <select name="card.part.{{i}}.scaling.mode">{{#each scaling.modes}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></div></div>
        {{/if}}
        {{/each}}
        {{#unless noAdd}}<button type="button" data-action="addDamagePart" data-home="{{home}}"><i class="fa-solid fa-plus"></i> {{localize "midi-qol.EntryEditor.Activity.AddDamage"}}</button>{{/unless}}
        {{/if}}
        {{#if healing}}
        <div class="form-group">
            <label>{{localize "midi-qol.EntryEditor.Activity.HealingField"}}</label>
            <div class="form-fields">
                <input type="text" name="card.healing.formula" value="{{healing.formula}}">
                <select name="card.healing.types" multiple class="midi-qol-entry-multiselect">{{#each healing.types}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
            </div>
        </div>
        {{/if}}
        {{#if empty}}<p class="hint">{{localize "midi-qol.EntryEditor.Activity.NotHere"}}</p>{{/if}}
        {{#each effects}}
        <div class="form-group">
            <label>{{name}}</label>
            <div class="form-fields">
                {{#if canOnSave}}<label class="checkbox"><input type="checkbox" name="card.effect.{{id}}" {{#if onSave}}checked{{/if}}> {{localize "midi-qol.EntryEditor.Activity.EffectOnSave"}}</label>{{/if}}
                {{#if removable}}<button type="button" data-action="removeEffect" data-home="{{../home}}" data-id="{{id}}"><i class="fa-solid fa-trash"></i> {{localize "midi-qol.EntryEditor.Activity.RemoveEffect"}}</button>{{/if}}
            </div>
        </div>
        {{/each}}
        {{#if newEffect}}
        <div class="form-group">
            <label>{{localize "midi-qol.EntryEditor.Activity.EffectWhat"}}</label>
            <div class="form-fields"><select name="card.new.what">
                <option value="">—</option>
                {{#each newEffect.presets}}<optgroup label="{{label}}">{{#each options}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</optgroup>{{/each}}
                <optgroup label="{{localize "midi-qol.EntryEditor.Activity.Conditions"}}">{{#each newEffect.statuses}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</optgroup>
                {{#if newEffect.effects.length}}<optgroup label="{{localize "midi-qol.EntryEditor.Activity.ItemEffects"}}">{{#each newEffect.effects}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</optgroup>{{/if}}
                <option value="new" {{#if newEffect.isNew}}selected{{/if}}>{{localize "midi-qol.EntryEditor.Activity.NewEffect"}}</option>
            </select></div>
        </div>
        {{#with newEffect.param}}<div class="form-group"><label>{{label}}</label><div class="form-fields">
            {{#if isSelect}}<select name="card.new.param">{{#each options}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
            {{else}}<input type="{{#if isNumber}}number{{else}}text{{/if}}" name="card.new.param" value="{{value}}">{{/if}}</div></div>{{/with}}
        {{#if newEffect.isNew}}<div class="form-group"><label>{{localize "midi-qol.EntryEditor.Activity.EffectName"}}</label><div class="form-fields"><input type="text" name="card.new.name" value="{{newEffect.name}}"></div></div>{{/if}}
        <div class="form-group">
            <label>{{localize "midi-qol.EntryEditor.Activity.EffectFor"}}</label>
            <div class="form-fields"><input type="number" name="card.new.duration" value="{{newEffect.duration}}" min="0" step="1">
                <select name="card.new.units">{{#each newEffect.units}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></div>
        </div>
        {{#if newEffect.canRepeat}}<div class="form-group"><label></label><div class="form-fields"><label class="checkbox"><input type="checkbox" name="card.new.repeat" {{#if newEffect.repeat}}checked{{/if}}> {{localize "midi-qol.EntryEditor.Activity.RepeatSave"}}</label></div></div>{{/if}}
        <button type="button" data-action="confirmEffect" data-home="{{home}}"><i class="fa-solid fa-plus"></i> {{localize "midi-qol.EntryEditor.Activity.AddEffectConfirm"}}</button>
        {{/if}}
