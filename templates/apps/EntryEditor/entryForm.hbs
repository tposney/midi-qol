        <div class="midi-qol-entry-toolbar">
            <button type="button" data-action="remove"><i class="fa-solid fa-trash"></i> {{localize "midi-qol.EntryEditor.Remove"}}</button>
        </div>
        {{#if problems.length}}
        <ul class="midi-qol-entry-problems">{{#each problems}}<li>{{this}}</li>{{/each}}</ul>
        {{/if}}
        {{#if warnings.length}}
        <ul class="midi-qol-entry-warnings">{{#each warnings}}<li>{{this}}</li>{{/each}}</ul>
        {{/if}}
        {{#if jsonView}}
        <textarea name="json" rows="24" spellcheck="false">{{json}}</textarea>
        {{else}}
        <div class="form-group"><label>{{localize "midi-qol.EntryEditor.Field.id"}}</label><input type="text" name="id" value="{{entry.id}}"></div>
        <div class="form-group"><label>{{localize "midi-qol.EntryEditor.Field.on"}}</label>
            <multi-select name="on">{{#each events}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</multi-select></div>
        <div class="form-group"><label>{{localize "midi-qol.EntryEditor.Field.who"}}</label>
            <select name="who">{{#each who}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></div>
        {{#if whoJson}}
        <div class="form-group"><label>{{localize "midi-qol.EntryEditor.Field.whoJson"}}</label><input type="text" name="whoJson" value="{{whoJson}}" spellcheck="false"></div>
        {{/if}}
        {{#if near}}
        <div class="form-group"><label>{{localize "midi-qol.EntryEditor.Field.within"}}</label><input type="text" name="within" value="{{near.within}}"></div>
        <div class="form-group"><label>{{localize "midi-qol.EntryEditor.Field.of"}}</label><input type="text" name="of" value="{{near.of}}"></div>
        <div class="form-group"><label>{{localize "midi-qol.EntryEditor.Field.filter"}}</label><input type="text" name="filter" value="{{near.filter}}">
            <button type="button" class="midi-qol-entry-condition" data-action="editCondition" data-field="filter" data-tooltip="{{localize "midi-qol.EntryEditor.EditCondition"}}"><i class="fa-solid fa-code"></i></button></div>
        {{/if}}
        <div class="form-group"><label>{{localize "midi-qol.EntryEditor.Field.label"}}</label><input type="text" name="label" value="{{entry.label}}"></div>
        <div class="form-group"><label>{{localize "midi-qol.EntryEditor.Field.if"}}</label><textarea name="if" rows="2" spellcheck="false">{{entry.if}}</textarea>
            <button type="button" class="midi-qol-entry-condition" data-action="editCondition" data-field="if" data-tooltip="{{localize "midi-qol.EntryEditor.EditCondition"}}"><i class="fa-solid fa-code"></i></button></div>
        <div class="form-group"><label></label><select name="ifPreset"><option value="">{{localize "midi-qol.EntryEditor.Field.ifPreset"}}</option>{{#each ifPresets}}<option value="{{value}}">{{label}}</option>{{/each}}</select></div>
        <div class="form-group"><label>{{localize "midi-qol.EntryEditor.Field.offer"}}</label>
            <select name="offer">{{#each offers}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></div>
        <div class="form-group"><label>{{localize "midi-qol.EntryEditor.Field.activity"}}</label>
            <select name="activity">{{#each activities}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></div>
        <div class="form-group"><label>{{localize "midi-qol.EntryEditor.Field.limit"}}</label>
            <select name="limitPer">{{#each limits}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
            <input type="number" name="limitMax" value="{{entry.limit.max}}" min="1" step="1"></div>
        <div class="form-group"><label>{{localize "midi-qol.EntryEditor.Field.group"}}</label><input type="text" name="group" value="{{entry.group}}">
            <label class="checkbox"><input type="checkbox" name="stacks" {{#if entry.stacks}}checked{{/if}}> {{localize "midi-qol.EntryEditor.Field.stacks"}}</label></div>
        <div class="form-group stacked"><label>{{localize "midi-qol.EntryEditor.Field.do"}}</label>
            {{#if cardsShown}}
            {{#each actionCards}}
            <div class="midi-qol-entry-nest" style="padding-left: {{indent}}px">
            {{#if row}}
            <div class="midi-qol-entry-row">
                <strong>{{localize "midi-qol.EntryEditor.Row"}} {{number}}</strong>
                <label>{{localize "midi-qol.EntryEditor.RowFrom"}} <input type="number" name="{{name}}.min" value="{{min}}" step="1"></label>
                <label>{{localize "midi-qol.EntryEditor.RowTo"}} <input type="number" name="{{name}}.max" value="{{max}}" step="1"></label>
                <input type="text" name="{{name}}.label" value="{{label}}" placeholder="{{localize "midi-qol.EntryEditor.RowLabel"}}" aria-label="{{localize "midi-qol.EntryEditor.RowLabel"}}">
                <button type="button" data-action="addRowAction" data-path="{{path}}" data-row="{{k}}" data-tooltip="{{localize "midi-qol.EntryEditor.AddRowAction"}}" aria-label="{{localize "midi-qol.EntryEditor.AddRowAction"}}"><i class="fa-solid fa-plus"></i></button>
                <button type="button" data-action="removeRow" data-path="{{path}}" data-row="{{k}}" data-tooltip="{{localize "midi-qol.EntryEditor.Remove"}}" aria-label="{{localize "midi-qol.EntryEditor.Remove"}}"><i class="fa-solid fa-trash"></i></button>
            </div>
            {{else}}
            {{#if branchLabel}}<div class="midi-qol-entry-branch">{{branchLabel}}</div>{{/if}}
            <div class="midi-qol-entry-action">
                <div class="midi-qol-entry-action-head">
                    <select name="act.{{path}}.kind"><option value="" {{#unless key}}selected{{/unless}}>?</option>{{#each kinds}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
                    {{#unless first}}<button type="button" data-action="moveAction" data-path="{{path}}" data-dir="up" data-tooltip="{{localize "midi-qol.EntryEditor.MoveUp"}}"><i class="fa-solid fa-arrow-up"></i></button>{{/unless}}
                    {{#unless last}}<button type="button" data-action="moveAction" data-path="{{path}}" data-dir="down" data-tooltip="{{localize "midi-qol.EntryEditor.MoveDown"}}"><i class="fa-solid fa-arrow-down"></i></button>{{/unless}}
                    <button type="button" data-action="removeAction" data-path="{{path}}" data-tooltip="{{localize "midi-qol.EntryEditor.Remove"}}"><i class="fa-solid fa-trash"></i></button>
                </div>
                {{#if fields}}
                {{#each fields}}
                {{#if (eq type "rollSpec")}}
                <div class="form-group"><label>{{localize label}}</label>
                    <select name="{{rollSpec.modeName}}">{{#each rollSpec.modes}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></div>
                {{#if rollSpec.activity}}
                <div class="form-group"><label>{{localize "midi-qol.EntryEditor.Field.activityRef"}}</label>
                    <select name="{{rollSpec.activityName}}">{{#each rollSpec.activities}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></div>
                {{/if}}
                {{#if rollSpec.custom}}
                <div class="form-group"><label>{{localize "midi-qol.EntryEditor.Field.ability"}}</label>
                    <select name="{{rollSpec.abilityName}}">{{#each rollSpec.abilities}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></div>
                {{#if rollSpec.check}}
                <div class="form-group"><label>{{localize "midi-qol.EntryEditor.Field.skill"}}</label>
                    <select name="{{rollSpec.skillName}}">{{#each rollSpec.skills}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></div>
                {{/if}}
                <div class="form-group"><label>{{localize "midi-qol.EntryEditor.Field.dc"}}</label><input type="text" name="{{rollSpec.dcName}}" value="{{rollSpec.dc}}"></div>
                {{/if}}
                {{else}}
                <div class="form-group"><label>{{localize label}}</label>
                    {{#if (eq type "select")}}<select name="{{name}}">{{#each options}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
                    {{else if (eq type "boolean")}}<input type="checkbox" name="{{name}}" {{#if checked}}checked{{/if}}>
                    {{else if (eq type "number")}}<input type="number" name="{{name}}" value="{{value}}">
                    {{else if (eq type "condition")}}<input type="text" name="{{name}}" value="{{value}}"><button type="button" class="midi-qol-entry-condition" data-action="editCondition" data-field="{{name}}" data-tooltip="{{localize "midi-qol.EntryEditor.EditCondition"}}"><i class="fa-solid fa-code"></i></button>
                    {{else}}<input type="text" name="{{name}}" value="{{value}}" {{#if custom}}class="midi-qol-entry-custom" spellcheck="false" data-tooltip="{{localize "midi-qol.EntryEditor.CustomHint"}}"{{/if}}>{{/if}}
                </div>
                {{/if}}
                {{/each}}
                {{#if canAddRow}}
                <div class="midi-qol-entry-branch-buttons">
                    <button type="button" data-action="addRow" data-path="{{path}}"><i class="fa-solid fa-plus"></i> {{localize "midi-qol.EntryEditor.AddRow"}}</button>
                </div>
                {{/if}}
                {{#if canBranch}}
                <div class="midi-qol-entry-branch-buttons">
                    <button type="button" data-action="addBranch" data-path="{{path}}" data-branch="then"><i class="fa-solid fa-plus"></i> {{localize "midi-qol.EntryEditor.AddThen"}}</button>
                    <button type="button" data-action="addBranch" data-path="{{path}}" data-branch="else"><i class="fa-solid fa-plus"></i> {{localize "midi-qol.EntryEditor.AddElse"}}</button>
                </div>
                {{/if}}
                {{else}}
                <textarea name="act.{{path}}.json" rows="4" spellcheck="false">{{json}}</textarea>
                {{/if}}
            </div>
            {{/if}}
            </div>
            {{/each}}
            <button type="button" data-action="addAction"><i class="fa-solid fa-plus"></i> {{localize "midi-qol.EntryEditor.AddAction"}}</button>
            {{else}}
            <textarea name="do" rows="10" spellcheck="false">{{rawDo}}</textarea>
            {{/if}}
        </div>
        <div class="form-group stacked"><label>{{localize "midi-qol.EntryEditor.Field.choose"}}</label><textarea name="choose" rows="3" spellcheck="false">{{rawChoose}}</textarea></div>
        {{/if}}
