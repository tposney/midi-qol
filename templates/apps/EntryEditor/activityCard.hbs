<div class="midi-qol-activity-card">
    <div class="midi-qol-entry-line midi-qol-activity-when">
        <span>{{localize "midi-qol.EntryEditor.Activity.When"}}</span>
        {{#each when}}<button type="button" class="midi-qol-entry-chip builtin" data-action="editActivity" data-home="{{home}}" data-field="{{field}}" data-place="when">{{text}}</button> {{/each}}
        <span class="midi-qol-entry-views-gap"></span>
        <button type="button" class="midi-qol-activity-sheet" data-action="openActivitySheet" data-home="{{home}}" data-tooltip="{{localize "midi-qol.EntryEditor.Activity.Sheet"}}" aria-label="{{localize "midi-qol.EntryEditor.Activity.Sheet"}}"><i class="fa-solid fa-up-right-from-square"></i></button>
    </div>
    {{#if (eq popover.place "when")}}
    <div class="midi-qol-card-popover">
        {{#with popover.fields}}{{> "modules/midi-qol/templates/apps/EntryEditor/cardFields.hbs"}}{{/with}}
        <div class="midi-qol-card-popover-buttons">
            <button type="button" data-action="editActivity" data-home="{{home}}" data-field="all"><i class="fa-solid fa-list"></i> {{localize "midi-qol.EntryEditor.Activity.AllFields"}}</button>
            <button type="button" data-action="closeActivityField" data-home="{{home}}"><i class="fa-solid fa-check"></i> {{localize "midi-qol.EntryEditor.Activity.Done"}}</button>
        </div>
    </div>
    {{/if}}
    {{#if targeting}}
    <div class="midi-qol-entry-line midi-qol-activity-target"><span>{{localize "midi-qol.EntryEditor.Activity.Targets"}}</span>
        <button type="button" class="midi-qol-entry-chip builtin" data-action="editActivity" data-home="{{home}}" data-field="target" data-place="target">{{targeting.text}}</button></div>
    {{#if (eq popover.place "target")}}
    <div class="midi-qol-card-popover">
        {{#with popover.fields}}{{> "modules/midi-qol/templates/apps/EntryEditor/cardFields.hbs"}}{{/with}}
        <div class="midi-qol-card-popover-buttons">
            <button type="button" data-action="editActivity" data-home="{{home}}" data-field="all"><i class="fa-solid fa-list"></i> {{localize "midi-qol.EntryEditor.Activity.AllFields"}}</button>
            <button type="button" data-action="closeActivityField" data-home="{{home}}"><i class="fa-solid fa-check"></i> {{localize "midi-qol.EntryEditor.Activity.Done"}}</button>
        </div>
    </div>
    {{/if}}
    {{/if}}
    {{#if basics}}<div class="midi-qol-activity-basics hint">{{basics}}</div>{{/if}}
    {{#if midi}}<div class="midi-qol-activity-basics hint">{{localize "midi-qol.EntryEditor.Activity.Midi"}} {{midi}}</div>{{/if}}
    {{#if region}}
    <div class="midi-qol-activity-region">
        <div>{{region.text}}</div>
        <ul>{{#each region.rules}}<li>{{this}}</li>{{/each}}</ul>
    </div>
    {{/if}}
    {{#each branches}}
    <div class="midi-qol-activity-branch" data-branch="{{branch}}">
        <div class="midi-qol-entry-line midi-qol-activity-branch-line">
            <strong>{{label}}</strong>
            {{#each builtIn}}<button type="button" class="midi-qol-entry-chip builtin" data-action="editActivity" data-home="{{home}}" data-field="{{field}}" data-place="{{../branch}}">{{text}}</button>{{#unless @last}}, {{/unless}}{{/each}}
            {{#if nothing}}<span class="hint">{{localize "midi-qol.EntryEditor.Activity.Nothing"}}</span>{{/if}}
            <button type="button" class="midi-qol-branch-add" data-action="editActivity" data-home="{{home}}" data-field="newEffect" data-place="{{branch}}" data-tooltip="{{localize "midi-qol.EntryEditor.Activity.AddEffect"}}" aria-label="{{localize "midi-qol.EntryEditor.Activity.AddEffect"}}"><i class="fa-solid fa-wand-sparkles"></i></button>
            <button type="button" class="midi-qol-branch-add midi-qol-branch-add-action" data-action="addToBranch" data-home="{{home}}" data-branch="{{branch}}" data-tooltip="{{localize "midi-qol.EntryEditor.Activity.Add"}}" aria-label="{{localize "midi-qol.EntryEditor.Activity.Add"}}"><i class="fa-solid fa-plus"></i></button>
        </div>
        {{#if (eq ../popover.place branch)}}
    <div class="midi-qol-card-popover">
        {{#with ../popover.fields}}{{> "modules/midi-qol/templates/apps/EntryEditor/cardFields.hbs"}}{{/with}}
        <div class="midi-qol-card-popover-buttons">
            <button type="button" data-action="editActivity" data-home="{{home}}" data-field="all"><i class="fa-solid fa-list"></i> {{localize "midi-qol.EntryEditor.Activity.AllFields"}}</button>
            <button type="button" data-action="closeActivityField" data-home="{{home}}"><i class="fa-solid fa-check"></i> {{localize "midi-qol.EntryEditor.Activity.Done"}}</button>
        </div>
    </div>
    {{/if}}
        {{#if added}}
        <div class="midi-qol-entry-sentence-row midi-qol-branch-added {{#if added.problems.length}}invalid{{/if}}">
            <div class="midi-qol-entry-lines">
                {{#each added.lines}}
                <div class="midi-qol-entry-line" style="padding-left: {{indent}}px">{{#each parts}}{{#if kind}}<button type="button" class="midi-qol-entry-chip {{kind}} {{#if code}}code{{/if}}" data-action="focusPart" data-home="{{home}}" data-index="{{index}}" data-focus="{{focus}}">{{text}}</button>{{else}}<span>{{text}}</span>{{/if}} {{/each}}</div>
                {{/each}}
                {{#if added.problems.length}}<ul class="midi-qol-entry-problems">{{#each added.problems}}<li>{{this}}</li>{{/each}}</ul>{{/if}}
            </div>
            <button type="button" class="midi-qol-entry-edit" data-action="editEntry" data-home="{{home}}" data-index="{{added.index}}" data-tooltip="{{localize "midi-qol.EntryEditor.Edit"}}" aria-label="{{localize "midi-qol.EntryEditor.Edit"}}" aria-expanded="{{#if added.expanded}}true{{else}}false{{/if}}"><i class="fa-solid {{#if added.expanded}}fa-chevron-up{{else}}fa-pen{{/if}}"></i></button>
        </div>
        {{#if added.expanded}}
        <div class="midi-qol-entry-inline">
        {{> "modules/midi-qol/templates/apps/EntryEditor/entryForm.hbs" @root}}
        </div>
        {{/if}}
        {{/if}}
    </div>
    {{/each}}
    {{#each macros}}
    <div class="midi-qol-activity-macro">
        <div><i class="fa-solid fa-code"></i> {{sentence}}{{#if version}} <span class="hint">({{version}})</span>{{/if}}</div>
        {{#if notes}}<p class="hint">{{notes}}</p>{{/if}}
        {{#if settings}}<ul>{{#each settings}}<li>{{label}}: {{value}}</li>{{/each}}</ul>{{/if}}
        <p class="hint">{{localize "midi-qol.EntryEditor.Automation.Unreadable"}}</p>
        {{#if code}}<details class="midi-qol-entry-automation-code"><summary>{{localize "midi-qol.EntryEditor.Automation.Code"}}</summary><pre>{{code}}</pre></details>{{/if}}
    </div>
    {{/each}}
    {{#with open}}
    <fieldset class="midi-qol-activity-fields">
        <legend>{{localize "midi-qol.EntryEditor.Activity.Fields"}}</legend>
        {{> "modules/midi-qol/templates/apps/EntryEditor/cardFields.hbs"}}
        <p class="hint">{{localize "midi-qol.EntryEditor.Activity.FieldsHint"}}</p>
    </fieldset>
    {{/with}}
</div>
