<section class="midi-stats-view">
    <header class="midi-stats-toolbar">
        <div class="midi-stats-period" role="group">
            <button type="button" data-action="period" data-period="session" class="{{#if session}}active{{/if}}">{{localize "midi-qol.stats.Session"}}</button>
            <button type="button" data-action="period" data-period="lifetime" class="{{#unless session}}active{{/unless}}">{{localize "midi-qol.stats.Lifetime"}}</button>
        </div>
        <select name="filter">
            {{#each filters}}<option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{localize this.label}}</option>{{/each}}
        </select>
        {{#if session}}<span class="midi-stats-since hint">{{sessionSince}}</span>{{/if}}
    </header>
    {{#if off}}<p class="midi-stats-off hint"><i class="fas fa-circle-pause"></i> {{localize "midi-qol.stats.Off"}}</p>{{/if}}
    {{#if rows.length}}
        <div class="midi-stats-table">
            <div class="midi-stats-head">
                <a class="midi-stats-name {{#if nameSorted}}sorted{{/if}}" data-action="sort" data-key="name">{{localize "midi-qol.stats.Creature"}}{{#if nameSorted}} <i class="fas fa-caret-{{#if desc}}down{{else}}up{{/if}}"></i>{{/if}}</a>
                {{#each columns}}
                    <a class="midi-stats-num {{#if this.sorted}}sorted{{/if}}" data-action="sort" data-key="{{this.key}}">{{localize this.label}}{{#if this.sorted}} <i class="fas fa-caret-{{#if this.desc}}down{{else}}up{{/if}}"></i>{{/if}}</a>
                {{/each}}
            </div>
            <div class="midi-stats-rows">
                {{#each rows}}
                    <div class="midi-stats-row {{#if this.expanded}}expanded{{/if}}" data-id="{{this.id}}">
                        <div class="midi-stats-line" data-action="toggle">
                            <span class="midi-stats-name">
                                <i class="fas fa-chevron-right midi-stats-chevron"></i>
                                {{#if this.img}}<img src="{{this.img}}" alt="">{{/if}}
                                {{#if this.player}}<i class="fas fa-user" data-tooltip="{{localize "midi-qol.stats.Player"}}"></i>{{/if}}
                                {{this.name}}
                            </span>
                            {{#each this.cells}}<span class="midi-stats-num">{{this.text}}</span>{{/each}}
                        </div>
                        {{#if this.detail}}
                            <div class="midi-stats-detail">
                                {{#if this.detail.attacks}}<p><i class="fas fa-dice-d20"></i> {{this.detail.attacks}}</p>{{/if}}
                                {{#if this.detail.damage}}<p><i class="fas fa-burst"></i> {{this.detail.damage}}</p>{{/if}}
                                {{#if this.detail.byType.length}}
                                    <div class="midi-stats-bytype">
                                        {{#each this.detail.byType}}
                                            <span class="midi-stats-type">{{this.label}}</span>
                                            <span class="midi-stats-bar" data-tooltip="{{localize "midi-qol.stats.RolledApplied"}}">
                                                <span class="rolled" style="width: {{this.rolledWidth}}%"></span>
                                                <span class="applied" style="width: {{this.appliedWidth}}%"></span>
                                            </span>
                                            <span class="midi-stats-num">{{this.applied}} / {{this.rolled}}</span>
                                        {{/each}}
                                    </div>
                                {{/if}}
                                {{#if this.detail.defence}}<p><i class="fas fa-shield-halved"></i> {{this.detail.defence}}</p>{{/if}}
                                {{#if this.detail.items.length}}
                                    <table class="midi-stats-items">
                                        <thead><tr>
                                            <th>{{localize "midi-qol.stats.Item"}}</th><th>{{localize "midi-qol.stats.Attacks"}}</th><th>{{localize "midi-qol.stats.hitRate"}}</th>
                                            <th>{{localize "midi-qol.stats.Uses"}}</th><th>{{localize "midi-qol.stats.Damage"}}</th><th>{{localize "midi-qol.stats.AvgDmg"}}</th><th>{{localize "midi-qol.stats.kills"}}</th>
                                        </tr></thead>
                                        <tbody>
                                            {{#each this.detail.items}}
                                                <tr><td>{{this.name}}</td><td>{{this.attacks}}</td><td>{{this.hitPct}}</td><td>{{this.uses}}</td><td>{{this.damage}}</td><td>{{this.avgDamage}}</td><td>{{this.kills}}</td></tr>
                                            {{/each}}
                                        </tbody>
                                    </table>
                                {{/if}}
                                {{#if @root.isGM}}
                                    <button type="button" class="midi-stats-remove" data-action="removeStats"><i class="fas fa-user-minus"></i> {{localize "midi-qol.RemoveStats"}}</button>
                                {{/if}}
                            </div>
                        {{/if}}
                    </div>
                {{/each}}
            </div>
        </div>
    {{else}}
        <div class="midi-stats-empty">
            <i class="fas fa-chart-bar"></i>
            <span>{{localize "midi-qol.stats.NoStats"}}</span>
        </div>
    {{/if}}
</section>
