{{!--
  One roll section of the usage card.

  `midi-qol-section-filled` is applied only when the section has content, which is the same signal
  the old splice used — the empty container and the filled one were different markup, and midi's CSS
  distinguishes them.
--}}
<div class="midi-qol-{{ name }}{{#if section.html }} midi-qol-section-filled{{/if}}">
    {{#if section.label }}<div class="midi-roll-label">{{{ section.label }}}</div>{{/if}}
    {{{ section.html }}}
    <div class="end-midi-qol-{{ name }}"></div>
</div>
